---
/**
 * Community Page - Events, clubs, community info
 * Data: WordPress GraphQL (posts with event CMB2 fields)
 */
import MainLayout from '@/layouts/Layout.astro';
import Button from '@/components/starwind/button/Button.astro';
import { getEvents } from '@/lib/wordpress';
import { whatsappUrl } from '@/lib/config';

const events = await getEvents();

// ── Default Content ──
const hero = {
  label: 'CONNECT BEYOND',
  title: 'THE',
  highlight: 'COMMUNITY.',
  description: 'Connect, compete, grow together.',
};
---

<MainLayout title="BRESSEL Community" description="Connect, compete, and rank up.">
  <main class="pt-20 md:pt-24">
    <!-- Hero -->
    <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, var(--color-background), var(--color-background), var(--color-muted));"></div>
      <div class="relative z-10 text-center px-6">
        <p class="caption mb-4">{hero.label}</p>
        <h1 class="heading-xl mb-6">{hero.title} <span style="color: var(--color-bressel-red);">{hero.highlight}</span></h1>
        <p class="body-lg max-w-2xl mx-auto">{hero.description}</p>
      </div>
    </section>

    <!-- Upcoming Events -->
    <section id="events" class="py-20 noise-overlay">
      <div class="container-custom">
        <div class="mb-12">
          <p class="caption mb-2">WHAT'S ON</p>
          <h2 class="heading-lg">UPCOMING <span style="color: var(--color-bressel-red);">EVENTS.</span></h2>
        </div>
        <div class="space-y-4">
          {events.map((event) => {
            const eventDate = event.eventDate ? new Date(event.eventDate) : null;
            return (
              <article class="premium-card p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-8 group">
                {eventDate && (
                  <>
                    <div class="flex md:flex-col items-center md:items-start gap-3 md:gap-1 md:min-w-[100px]">
                      <span class="font-header font-black text-3xl" style="color: var(--color-bressel-red);">
                        {eventDate.toLocaleString('default', { month: 'short' }).toUpperCase()}
                      </span>
                      <span class="font-header font-black text-3xl" style="color: var(--color-foreground);">
                        {eventDate.getDate()}
                      </span>
                    </div>
                    <div class="hidden md:block w-px h-12" style="background: var(--color-border);"></div>
                  </>
                )}
                <div class="flex-1">
                  {event.eventLocation && (
                    <span class="text-[0.625rem] font-bold uppercase tracking-wider" style="color: var(--color-bressel-red);">{event.eventLocation}</span>
                  )}
                  <h3 class="font-header font-black italic text-xl uppercase mb-2" style="color: var(--color-foreground);">{event.title}</h3>
                  {event.excerpt }
                  {event.eventLocation && (
                    <p class="text-[0.6875rem] font-bold uppercase tracking-wider" style="color: var(--color-bressel-zinc-600);">📍 {event.eventLocation}</p>
                  )}
                </div>
                {event.eventRegistrationUrl && (
                  <a
                    href={event.eventRegistrationUrl}
                    class="md:self-center inline-flex items-center gap-1.5 uppercase no-underline whitespace-nowrap transition-colors"
                    style="font-family: var(--font-header); font-weight: 700; font-size: 0.625rem; letter-spacing: 0.1em; color: var(--color-muted-foreground);"
                  >
                    REGISTER
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Community CTA -->
    <section class="py-20 border-t" style="border-color: var(--color-border);">
      <div class="container-custom text-center">
        <h2 class="heading-lg mb-6">JOIN THE <span style="color: var(--color-bressel-red);">MOVEMENT.</span></h2>
        <p class="body-lg max-w-xl mx-auto mb-8">Be part of the fastest growing padel community in Asia. Tournament invites, gear drops, and stories from the court.</p>
        <a
          href={whatsappUrl("Hi BRESSEL! I'd like to join a court or community program. How do I get started?")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-bressel-red text-bressel-white font-header font-bold text-[0.6875rem] uppercase tracking-wide no-underline transition-colors hover:bg-bressel-red-hover"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          GET IN TOUCH
        </a>
      </div>
    </section>
  </main>
</MainLayout>
