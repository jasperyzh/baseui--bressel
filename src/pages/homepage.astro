---
/**
 * Homepage — Starwind UI demo page
 *
 * ── WP-GraphQL Ready ──
 * Swap frontmatter with WP response:
 *   const page = data.data.page;
 *   const hero = { title: page.title, ... };
 */
import MainLayout from '@/layouts/Layout.astro';
import Button from '@/components/starwind/button/Button.astro';
import Badge from '@/components/starwind/badge/Badge.astro';
import Card from '@/components/starwind/card/Card.astro';
import CardHeader from '@/components/starwind/card/CardHeader.astro';
import CardTitle from '@/components/starwind/card/CardTitle.astro';
import CardDescription from '@/components/starwind/card/CardDescription.astro';
import CardContent from '@/components/starwind/card/CardContent.astro';
---

<MainLayout
  title="Welcome — Starwind UI"
  description="A clean landing page built with Starwind UI components."
>
  <!-- Hero Section -->
  <section class="flex flex-col items-center justify-center min-h-[60vh] gap-6 text-center">
    <Badge variant="secondary" class="text-sm">BRESSEL PRO</Badge>
    <h1>Build with Starwind UI</h1>
    <p>Pre-built, accessible, and fully themed components. No CSS bridge. Just components.</p>
    <div class="flex gap-4 mt-4">
      <Button size="lg">Get Started</Button>
      <Button variant="outline" size="lg">Documentation</Button>
    </div>
  </section>

  <!-- Features Section -->
  <section class="max-w-5xl mx-auto py-16 px-4">
    <h2>Features</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <Card>
        <CardHeader>
          <CardTitle>Astro Native</CardTitle>
          <CardDescription>Built for Astro v6 with zero JS overhead. Ship less, do more.</CardDescription>
        </CardHeader>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle>Tailwind v4</CardTitle>
          <CardDescription>Full Tailwind CSS v4 support with CSS variables theming.</CardDescription>
        </CardHeader>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle>Accessible</CardTitle>
          <CardDescription>ARIA-compliant components with keyboard navigation built in.</CardDescription>
        </CardHeader>
      </Card>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="max-w-3xl mx-auto py-16 px-4 text-center">
    <Card>
      <CardHeader>
        <CardTitle>Ready to start?</CardTitle>
        <CardDescription>Install Starwind UI and build your next project with confidence.</CardDescription>
      </CardHeader>
      <CardContent class="text-center">
        <Button size="lg" variant="default">
          npm create astro@latest
        </Button>
      </CardContent>
    </Card>
  </section>
</MainLayout>
