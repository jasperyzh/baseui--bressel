---
/**
 * Contact Page — WhatsApp-first inquiry strategy
 * Per client direction: WhatsApp is the primary contact point
 * Removed full contact form — replaced with WhatsApp buttons per context
 *
 * ── WP-GraphQL Ready ──
 * Replace locations with WP response:
 *   const page = data.data.page;
 *   const locations = page.acfLocations;
 */
import MainLayout from '@/layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '@/lib/config';

const waPhone = WHATSAPP_NUMBER;
const encode = (s: string) => encodeURIComponent(s);

const quickInquiries = [
  {
    label: "TRAINING PROGRAMS",
    message: "Hi BRESSEL! I'm interested in your training programs. Could you share the details and pricing?",
    desc: "Sessions, packages, and coaching."
  },
  {
    label: "EVENTS",
    message: "Hi BRESSEL! I'd like to register for an event. How do I sign up?",
    desc: "Tournaments, workshops, community days."
  },
  {
    label: "EQUIPMENT",
    message: "Hi BRESSEL! I'm interested in your equipment. Is it available?",
    desc: "Rackets, gear, and BRESSEL PRO."
  },
  {
    label: "GENERAL",
    message: "Hi BRESSEL! I'd like to know more about BRESSEL.",
    desc: "Anything else — we're here to help."
  },
];

const locations = [
  { name: "MALAYSIA", message: "Hi BRESSEL! I'd like to know more about the Malaysia facility." },
  { name: "PHILIPPINES", message: "Hi BRESSEL! I'd like to know more about the Philippines facility." },
  { name: "SINGAPORE", message: "Hi BRESSEL! I'd like to know more about the Singapore facility." },
];
---

<MainLayout title="Contact BRESSEL" description="Get in touch via WhatsApp.">
  <main class="pt-20 md:pt-24">
    <!-- Hero -->
    <section class="relative min-h-[40vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, var(--color-background), var(--color-background), var(--color-muted));"></div>
      <div class="relative z-10 text-center px-6">
        <p class="caption mb-4">LET'S TALK</p>
        <h1 class="heading-xl mb-6"><span style="color: var(--color-bressel-red);">CONTACT.</span></h1>
        <p class="body-lg max-w-xl mx-auto">Quick inquiry via WhatsApp. We respond fast.</p>
      </div>
    </section>

    <!-- Quick Inquiry WhatsApp Buttons -->
    <section class="py-20 noise-overlay">
      <div class="container-custom">
        <div class="mb-12 text-center">
          <p class="caption mb-4">QUICK INQUIRY</p>
          <h2 class="heading-lg mb-4">WHAT'S THIS <span style="color: var(--color-bressel-red);">ABOUT?</span></h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
          {quickInquiries.map((inq) => (
            <a
              href={`https://wa.me/${waPhone}?text=${encode(inq.message)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="premium-card block p-6 no-underline group"
            >
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-bressel-red flex items-center justify-center">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-bressel-white">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide mb-1 group-hover:text-bressel-red transition-colors" style="color: var(--color-foreground);">
                    {inq.label}
                  </h3>
                  <p class="body text-sm" style="color: var(--color-muted-foreground);">{inq.desc}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Our Locations -->
    <section class="py-20 border-t" style="border-color: var(--color-border);">
      <div class="container-custom">
        <div class="mb-12 text-center">
          <p class="caption mb-4">FIND US</p>
          <h2 class="heading-lg">OUR <span style="color: var(--color-bressel-red);">LOCATIONS.</span></h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {locations.map((loc) => (
            <a
              href={`https://wa.me/${waPhone}?text=${encode(loc.message)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="premium-card block p-6 text-center no-underline group"
            >
              <div class="w-12 h-12 mx-auto mb-4 bg-bressel-red flex items-center justify-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-bressel-white">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="font-header font-bold text-sm uppercase tracking-wide mb-2 group-hover:text-bressel-red transition-colors" style="color: var(--color-foreground);">
                {loc.name}
              </h3>
              <p class="body text-xs" style="color: var(--color-muted-foreground);">Inquire via WhatsApp →</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Email (secondary) -->
    <section class="py-12">
      <div class="container-custom text-center">
        <p class="caption mb-2">EMAIL US</p>
        <a href="mailto:hola@bresselsports.com" class="no-underline text-lg font-header font-bold tracking-wide transition-colors" style="color: var(--color-bressel-red);">
          hola@bresselsports.com
        </a>
        <p class="body text-sm mt-2" style="color: var(--color-muted-foreground);">Secondary channel — we'll reply within 24 hours.</p>
      </div>
    </section>
  </main>
</MainLayout>
