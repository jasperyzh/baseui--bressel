---
/**
 * blog/[slug].astro - Blog Post Template
 *
 * Renders individual WordPress posts (including event posts with CMB2 fields).
 * getStaticPaths() generates pages for all published posts at build time.
 *
 * Supports both:
 *   1. Regular blog posts - shows title, date, content
 *   2. Event posts (with CMB2 eventDate/eventLocation/eventRegistrationUrl)
 *      - shows event badge, date, location, registration CTA
 */

import MainLayout from '@/layouts/Layout.astro';
import { getAllPostSlugs, getPostBySlug } from '@/lib/wordpress';
import { fixImageUrl, fixImageUrlsInHtml } from '@/lib/fix-image-url';
import type { WPPost } from '@/lib/wordpress';

// ── Static Paths ───────────────────────────────────────────
export async function getStaticPaths() {
  const allSlugs = await getAllPostSlugs();
  return allSlugs.map(({ slug }) => ({ params: { slug } }));
}

// ── Post Data ──────────────────────────────────────────────
const { slug } = Astro.params;
const post: WPPost | null = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/404');
}

// Utility
function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}

function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

// Fix mixed content — rewrite HTTP WP URLs to HTTPS proxy
const fixedFeaturedImage = post.featuredImage?.node?.sourceUrl
  ? fixImageUrl(post.featuredImage.node.sourceUrl)
  : undefined;
const fixedContent = fixImageUrlsInHtml(post.content);

const metaDesc = stripHtml(post.excerpt || post.content).slice(0, 160);
const isEvent = !!post.eventDate;
const eventDate = post.eventDate ? new Date(post.eventDate) : null;
---

<MainLayout title={post.title} description={metaDesc}>
  <main class="pt-20 md:pt-24 min-h-screen">

    <!-- ── Hero Section ── -->
    <section class="relative flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, var(--color-background), var(--color-background), var(--color-muted));"></div>

      {fixedFeaturedImage && (
        <div class="absolute inset-0 z-0 opacity-30">
          <img
            src={fixedFeaturedImage}
            alt={post.featuredImage?.node?.altText || post.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="relative z-10 text-center px-6 py-20 max-w-3xl mx-auto">

        <!-- Blog/Event label -->
        <p class="caption mb-6">
          {isEvent ? 'COMMUNITY EVENT' : 'BLOG'}
        </p>

        <h1 class="mb-6">{post.title}</h1>

        <!-- Meta row: date + category -->
        <div class="flex items-center justify-center gap-4 text-sm text-muted-foreground mb-6">
          <time datetime={post.date}>{formatDate(post.date)}</time>
          {isEvent && post.eventLocation && (
            <>
              <span aria-hidden="true">·</span>
              <span>📍 {post.eventLocation}</span>
            </>
          )}
        </div>

        {post.excerpt && (
          <p class="body-lg max-w-2xl mx-auto">{stripHtml(post.excerpt)}</p>
        )}

        <!-- Event Registration CTA (if event with registration link) -->
        {isEvent && post.eventRegistrationUrl && (
          <a
            href={post.eventRegistrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center justify-center gap-2 px-8 py-3 bg-bressel-red text-bressel-white font-header font-bold text-[0.6875rem] uppercase tracking-wide no-underline transition-colors hover:bg-bressel-red-hover"
          >
            REGISTER NOW
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        )}
      </div>
    </section>

    <!-- ── Event Date Badge (if event) ── -->
    {isEvent && eventDate && (
      <section class="py-8 border-y border-border">
        <div class="container-custom">
          <div class="flex flex-wrap items-center justify-center gap-8">
            <div class="flex items-center gap-3">
              <span class="text-xs uppercase font-bold tracking-wider text-muted-foreground">Date</span>
              <span class="font-header font-black text-lg text-bressel-red">
                {eventDate.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
            </div>
            {post.eventLocation && (
              <div class="flex items-center gap-3">
                <span class="text-xs uppercase font-bold tracking-wider text-muted-foreground">Location</span>
                <span class="font-header font-bold text-lg">{post.eventLocation}</span>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- ── Content Section ── -->
    <section class="py-16">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto prose prose-invert prose-lg">
          <div set:html={fixedContent} />
        </div>
      </div>
    </section>

    <!-- ── Back to Blog ── -->
    <section class="pb-16">
      <div class="container-custom text-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-header font-bold text-xs uppercase tracking-wider no-underline transition-colors text-muted-foreground"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          BACK TO BLOG
        </a>
      </div>
    </section>

  </main>
</MainLayout>
