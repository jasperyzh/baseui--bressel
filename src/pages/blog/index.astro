---
/**
 * blog/index.astro - Blog Archive
 *
 * Lists all published WordPress posts in reverse chronological order.
 * Provides discoverability for blog content and SEO content hub.
 *
 * Each entry shows: featured image (thumbnail), title, date, excerpt.
 * Clicking a title links to /blog/[slug].
 *
 * Event posts also appear here - they're WordPress posts with CMB2 fields.
 */

import MainLayout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getAllPosts } from '@/lib/wordpress';
import { fixImageUrl } from '@/lib/fix-image-url';

// ── Archive Data ───────────────────────────────────────────
const posts = await getAllPosts();

// Utility
function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}

function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}
---

<MainLayout
  title="Blog"
  description="The latest from BRESSEL - tournament recaps, coaching tips, community stories."
>
  <main class="pt-20 md:pt-24 min-h-screen">

    <PageHero
      label="THE LATEST"
      title="BRESSEL"
      highlight="BLOG"
      description="Tournament recaps, coaching tips, and stories from the community."
      size="md"
    />

    <!-- ── Posts List ── -->
    <section class="py-20 noise-overlay">
      <div class="container-custom">

        {posts.length === 0 && (
          <div class="max-w-2xl mx-auto">
            <EmptyState
              title="No posts yet."
              description="We’ll share tournament recaps, coaching notes, and community stories here."
            />
          </div>
        )}

        <div class="space-y-6">
          {posts.map((p) => {
            const excerpt = stripHtml(p.excerpt || '').slice(0, 200);
            const fixedThumb = fixImageUrl(p.featuredImage?.node?.sourceUrl);
            const thumbAlt = p.featuredImage?.node?.altText || p.title;
            return (
              <article class="premium-card flex flex-col sm:flex-row gap-6 p-6">
                <!-- Thumbnail -->
                <a href={`/blog/${p.slug}`} class="block w-full sm:w-48 h-48 sm:h-32 flex-shrink-0 overflow-hidden">
                  {fixedThumb ? (
                    <img
                      src={fixedThumb}
                      alt={thumbAlt}
                      class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-muted">
                      <span class="font-header font-black text-3xl text-bressel-red">
                        {p.title.charAt(0).toUpperCase()}
                      </span>
                    </div>
                  )}
                </a>

                <!-- Content -->
                <div class="flex-1 flex flex-col justify-center">
                  <time
                    datetime={p.date}
                    class="text-xxs font-bold uppercase tracking-wider mb-2 text-bressel-red"
                  >
                    {formatDate(p.date)}
                  </time>
                  <h2 class="font-header font-black italic text-xl uppercase mb-2 text-foreground">
                    <a href={`/blog/${p.slug}`} class="no-underline hover:underline" style="color: inherit;">
                      {p.title}
                    </a>
                  </h2>
                  {excerpt && (
                    <p class="body text-sm line-clamp-2">{excerpt}</p>
                  )}
                  <a
                    href={`/blog/${p.slug}`}
                    class="mt-3 inline-flex items-center gap-1.5 font-header font-bold text-xxs uppercase tracking-wider no-underline transition-colors text-muted-foreground"
                  >
                    READ MORE
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

      </div>
    </section>

  </main>
</MainLayout>
