---
/**
 * Index / Homepage — Full page assembly
 * Data: WordPress GraphQL for dynamic sections
 */
import MainLayout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import BrandEssence from '@/components/sections/BrandEssence.astro';
import AcademyCards from '@/components/sections/AcademyCards.astro';
import Ticker from '@/components/sections/Ticker.astro';
import ProgramPillars from '@/components/sections/ProgramPillars.astro';
import Pricing from '@/components/sections/Pricing.astro';
import Voices from '@/components/sections/Quotes.astro';
import Centers from '@/components/sections/Centers.astro';
import Shop from '@/components/sections/Shop.astro';
import NewsletterCTA from '@/components/sections/NewsletterCTA.astro';
import { getMerch } from '@/lib/wordpress';

const products = await getMerch();
---

<MainLayout
  title="BRESSEL™ — World-Class Padel, Built Around People"
  description="World-class padel coaching built around community. From your first swing to tournament day — we're in it together."
>
  <Hero />

  <!-- ✦ Section: Brand Essence (dark) -->
  <section class="bg-bressel-black">
    <BrandEssence />
  </section>

  <!-- ✦ Section: Academy Cards (soft black — visual lift) -->
  <section class="bg-bressel-black-soft">
    <AcademyCards />
  </section>

  <Ticker variant="fade" />

  <!-- ✦ Section: Program Pillars (dark) -->
  <section class="bg-bressel-black">
    <ProgramPillars />
  </section>

  <!-- ✦ Swoosh divider: black → dark scarlet -->
  <div class="relative h-16 md:h-24 overflow-hidden bg-bressel-black">
    <div class="absolute inset-0 bg-bressel-red" style="clip-path: polygon(0 100%, 100% 0, 100% 100%)"></div>
  </div>

  <!-- ✦ Section: Pricing (dark scarlet → black gradient) -->
  <section class="bg-gradient-to-b from-bressel-red/10 to-bressel-black">
    <Pricing />
  </section>

  <!-- ✦ Thin red accent divider -->
  <div class="h-px bg-bressel-red/30 mx-auto max-w-5xl"></div>

  <!-- ✦ Section: Testimonials (soft black) -->
  <section class="bg-bressel-black-soft">
    <Voices />
  </section>

  <!-- ✦ Section: Centers (dark) -->
  <section class="bg-bressel-black">
    <Centers />
  </section>

  <!-- ✦ Thin red accent divider -->
  <div class="h-px bg-bressel-red/30 mx-auto max-w-5xl"></div>

  <!-- ✦ Section: Shop (soft black) -->
  <section class="bg-bressel-black-soft">
    <Shop products={products} />
  </section>

  <NewsletterCTA />
</MainLayout>
