---
/**
 * Academy Page — Coaches grid, programs info, booking CTA
 *
 * ── WP-GraphQL Ready ──
 * Replace coaches import with GraphQL query to custom post type:
 *   const { coaches } = data.data;
 *
 * const coaches = [
 *   { name, role, specialty, bio, image }
 * ];
 */
import MainLayout from '@/layouts/Layout.astro';
import Button from '@/components/starwind/button/Button.astro';
import coaches from '@/content/coaches.json';

// ── Default Content ──
const hero = {
  label: 'ACADEMY',
  title: 'THE',
  highlight: 'ACADEMY.',
  description: 'Champion-led training that meets you where you are.',
};
---

<MainLayout title="BRESSEL Academy" description="Elite coaching and training programs.">
  <main class="pt-20 md:pt-24">
    <!-- Hero -->
    <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, var(--color-background), var(--color-background), var(--color-muted));"></div>
      <div class="relative z-10 text-center px-6">
        <p class="caption mb-4">{hero.label}</p>
        <h1 class="heading-xl mb-6">{hero.title} <span style="color: var(--color-bressel-red);">{hero.highlight}</span></h1>
        <p class="body-lg max-w-2xl mx-auto">{hero.description}</p>
      </div>
    </section>

    <!-- Coaches Grid -->
    <section class="py-20 noise-overlay">
      <div class="container-custom">
        <div class="mb-12">
          <p class="caption mb-2">OUR TEAM</p>
          <h2 class="heading-lg">MEET THE <span style="color: var(--color-bressel-red);">COACHES.</span></h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {coaches.map((coach) => (
            <article class="overflow-hidden group transition-colors" style="background: var(--color-card); border: 1px solid var(--color-border);">
              <div class="aspect-[3/4] overflow-hidden">
                <img src={coach.image} alt={coach.name} class="w-full h-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105" />
              </div>
              <div class="p-5">
                <h3 class="font-header font-black italic text-lg uppercase mb-1" style="color: var(--color-foreground);">{coach.name}</h3>
                <p class="text-[0.625rem] font-bold uppercase tracking-wider mb-3" style="color: var(--color-bressel-red);">{coach.role}</p>
                <p class="body text-sm">{coach.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Programs -->
    <section id="programs" class="py-20">
      <div class="container-custom">
        <div class="mb-12">
          <p class="caption mb-2">TRAINING MODULES</p>
          <h2 class="heading-lg">PROGRAMS</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { title: 'PROFESSIONAL', description: 'For serious athletes ready to compete at the highest level. Intensive technical and tactical training.', features: ['1-on-1 coaching sessions', 'Video analysis & feedback', 'Tournament preparation'], source: 'professional' },
            { title: 'COMPETITION', description: 'Designed for regional tournament competitors. Strategy, endurance, and mental toughness.', features: ['Team training modules', 'Match simulation drills', 'Circuit participation'], source: 'competition' },
            { title: 'COACHES', description: 'Certification programs using the BRESSEL™ methodology. Train the next generation of coaches.', features: ['Level 1-3 certification', 'Teaching methodology', 'Practical assessment'], source: 'coaches' },
          ].map((prog) => (
            <div class="p-8" style="background: var(--color-card); border: 1px solid var(--color-border);">
              <div class="w-10 h-0.5 mb-6" style="background: var(--color-bressel-red);"></div>
              <h3 class="heading-md mb-4">{prog.title}</h3>
              <p class="body text-sm mb-6">{prog.description}</p>
              <ul class="space-y-2 mb-6">
                {prog.features.map((f) => (
                  <li class="body text-sm flex items-center gap-2"><span style="color: var(--color-bressel-red);">▸</span> {f}</li>
                ))}
              </ul>
              <a href={`/contact?intent=inquiry&source=${prog.source}`} class="nav-link inline-flex" style="color: var(--color-bressel-red);">INQUIRE NOW →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 border-t" style="border-color: var(--color-border);">
      <div class="container-custom text-center">
        <h2 class="heading-lg mb-6">READY TO <span style="color: var(--color-bressel-red);">BEGIN?</span></h2>
        <p class="body-lg max-w-xl mx-auto mb-8">Book your first session.</p>
        <a
          href="https://wa.me/60123456789?text=Hi%20BRESSEL!%20I'd%20like%20to%20start%20my%20padel%20journey.%20Could%20you%20share%20more%20about%20getting%20started?"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-bressel-red text-bressel-white font-header font-bold text-[0.6875rem] uppercase tracking-wide no-underline transition-colors hover:bg-bressel-red-hover"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          BOOK A SESSION
        </a>
      </div>
    </section>
  </main>
</MainLayout>
