---
/**
 * About Page - Brand story, mission, methodology
 *
 * ── WP-GraphQL Ready ──
 * Update `hero`, `stats` from WP response:
 *   const page = data.data.page;
 *   const hero = page.acfHero;
 *   const stats = page.acfStats;
 */

// ── Default Content ──
const hero = {
  tagline: 'EST. 2026 / PLAY BEYOND',
  title: 'The Bressel',
  highlight: 'standard',
  description: 'World-class padel within reach. Built around people who love the game.',
};

const stats = [
  { value: '3', label: 'Countries' },
  { value: '50+', label: 'Certified coaches' },
  { value: '2K+', label: 'Active players' },
  { value: '100+', label: 'Tournaments' },
  { value: '92%', label: 'Retention' },
];

const mission = {
  label: 'Our mission',
  title: 'Every player',
  highlight: 'counts',
  p1: 'BRESSEL was born from one belief: world-class coaching should not be locked behind elite circles.',
  p2: 'From your first swing to tournament day, every session is designed to build your game — and a community that lasts.',
  image: '/assets/national_team/nationalteam_group--Bressel-7473.webp',
};

const methodologies = [
  { title: 'Technical', description: 'Every movement mapped. Every shot broken into clear, repeatable steps you can take to the court.' },
  { title: 'Tactical', description: 'Court intelligence, pattern recognition, and decisions under pressure — a next-move mindset.' },
  { title: 'Physical', description: 'Explosive agility, lateral stability, and endurance built specifically for padel.' },
];

import MainLayout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
---

<MainLayout title="About BRESSEL" description="World-class padel coaching built around people who love the game.">
  <main class="pt-20 md:pt-24">
    <PageHero
      tagline={hero.tagline}
      title={hero.title}
      highlight={hero.highlight}
      description={hero.description}
      size="md"
    />

    <!-- Mission -->
    <section class="py-20 noise-overlay">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="caption mb-4">{mission.label}</p>
            <h2 class="mb-6">{mission.title}<br /><span class="text-bressel-red">{mission.highlight}</span></h2>
            <p class="body-lg mb-6">{mission.p1}</p>
            <p class="body">{mission.p2}</p>
          </div>
          <div class="premium-card overflow-hidden">
            <img src={mission.image} alt="BRESSEL Academy" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Strip -->
    <section class="py-16 border-y border-border">
      <div class="container-custom">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center">
          {stats.map((s) => (
            <div>
              <p class="text-4xl md:text-5xl mb-2 font-header font-bold text-bressel-red">{s.value}</p>
              <p class="heading-sm text-muted-foreground">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Methodology -->
    <section class="py-20">
      <div class="container-custom text-center">
        <p class="caption mb-4">The methodology</p>
        <h2 class="mb-16">Three <span class="text-bressel-red">pillars</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {methodologies.map((m) => (
            <div class="premium-card p-8">
              <div class="premium-separator mb-6 mx-auto"></div>
              <h3 class="mb-4">{m.title}</h3>
              <p class="body text-sm">{m.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
