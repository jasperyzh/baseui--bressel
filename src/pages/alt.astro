---
/**
 * BRESSEL™ — Live Beyond
 * Premium Alternate Landing Page
 *
 * Brand Compliance:
 *   - Fonts: Neue Regrade (headlines), Barlow Condensed (sections), Avenir Next (body)
 *   - Colors: Scarlet Surge #FF331F, Net Black #090808, Service White #FBFBFF, Ash Haze #D9D9D9
 *   - Gradients: NONE (prohibited by brand guidelines)
 *   - SURGE element: 80° forward-leaning brand shape
 *   - Voice: Direct. Energizing. Human.
 */

import MainLayout from '@/layouts/Layout.astro';
import SurgeDivider from '@/components/brand/SurgeDivider.astro';
import Icon from '@/components/Icon.astro';

const coaches = [
  { name: "Dani Bressel", role: "Head Coach & Founder", specialty: "Elite Performance" },
  { name: "Sofia Reyes", role: "Technical Coach", specialty: "Game Strategy" },
  { name: "Marco Tan", role: "Youth Academy Lead", specialty: "Development" },
];
---
<MainLayout title="BRESSEL™ — Live Beyond" description="Padel built around you.">

  <!-- ═══ HERO ═══ -->
  <section id="hero" class="relative h-screen min-h-[680px] flex items-center justify-center overflow-hidden bg-bressel-black">
    <div class="absolute inset-0">
      <img src="/assets/hero-bg.webp" alt="" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0" style="background: var(--color-net-black); opacity: 0.6;"></div>
      <div class="absolute top-20 right-10 opacity-[0.04] rotate-12 pointer-events-none hidden md:block">
        <SurgeDivider direction="horizontal" color="primary" size="lg" />
      </div>
      <div class="absolute bottom-20 left-10 opacity-[0.03] -rotate-12 pointer-events-none hidden md:block">
        <SurgeDivider direction="horizontal" color="primary" size="lg" />
      </div>
    </div>
    <div class="relative z-10 container-custom px-6 md:px-10 max-w-7xl mx-auto">
      <div class="max-w-3xl" data-aos="fade-up" data-aos-duration="900">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-10" style="background: var(--color-bressel-red);"></div>
          <span class="uppercase block text-[0.5625rem] font-semibold tracking-[0.12em]" style="font-family: 'Barlow Condensed', sans-serif; color: var(--color-bressel-red);">EST. 2025 — PLAY BEYOND</span>
        </div>
        <h1 style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(2.8rem, 8vw, 6rem); line-height: 0.9; letter-spacing: -0.02em; color: var(--color-service-white);">
          <span class="block">Train with</span>
          <span class="block" style="color: var(--color-bressel-red);">champions.</span>
        </h1>
        <p class="mb-10 max-w-xl" style="font-family: 'Avenir Next', sans-serif; font-size: 1.125rem; line-height: 1.75; color: var(--color-ash-haze);">
          World-class padel coaching built around you. From first swing to tournament day — we're in it together.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/academy" class="inline-flex items-center justify-center gap-2 px-8 py-4 no-underline"
             style="background: var(--color-bressel-red); color: var(--color-service-white); font-family: 'Neue Regrade', sans-serif; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; transition: background 0.3s ease;">
            <span>Book Session</span>
            <Icon name="arrow-right" size={14} />
          </a>
          <a href="#philosophy" class="inline-flex items-center justify-center gap-2 px-8 py-4 no-underline"
             style="border: 2px solid var(--color-border); color: var(--color-service-white); font-family: 'Neue Regrade', sans-serif; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; transition: border 0.3s ease, color 0.3s ease;">
            <span>Meet Coaches</span>
          </a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10" data-aos="fade-up" data-aos-delay="900">
      <div class="flex flex-col items-center gap-1">
        <span class="uppercase block text-[0.5rem] font-semibold tracking-[0.12em]" style="font-family: 'Barlow Condensed', sans-serif; color: var(--color-ash-haze);">Scroll</span>
        <div class="w-px h-6" style="background: var(--color-bressel-red);"></div>
      </div>
    </div>
  </section>

  <!-- ═══ PHILOSOPHY ═══ -->
  <section id="philosophy" class="relative py-32 md:py-40 bg-bressel-black overflow-hidden">
    <div class="container-custom px-6 md:px-10 max-w-7xl mx-auto">
      <div class="mb-16 text-center" data-aos="fade-up">
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="h-px w-8" style="background: var(--color-bressel-red);"></div>
          <span class="uppercase block text-[0.5625rem] font-semibold tracking-[0.15em]" style="font-family: 'Barlow Condensed', sans-serif; color: var(--color-bressel-red);">Our Philosophy</span>
          <div class="h-px w-8" style="background: var(--color-bressel-red);"></div>
        </div>
        <h2 style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(1.8rem, 4.5vw, 3.2rem); line-height: 1; letter-spacing: -0.01em; color: var(--color-service-white);">
          Every player has a place here.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        <!-- 01 Precision -->
        <div class="group relative p-8 md:p-10" style="border: 1px solid var(--color-border); background: var(--color-bressel-black-soft);" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-6"><SurgeDivider direction="horizontal" color="primary" size="sm" /></div>
          <span style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-size: 2.5rem; color: var(--color-ash-haze); opacity: 0.15; line-height: 1; display: block; margin-bottom: 1.5rem;">01</span>
          <h3 style="font-family: 'Neue Regrade', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--color-service-white); margin-bottom: 0.75rem;">Precision</h3>
          <p style="font-family: 'Avenir Next', sans-serif; font-size: 0.9375rem; line-height: 1.7; color: var(--color-ash-haze);">Every technique refined. Our coaches know exactly what your game needs.</p>
        </div>
        <!-- 02 Passion -->
        <div class="group relative p-8 md:p-10" style="border: 1px solid var(--color-border); background: var(--color-bressel-black-soft);" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-6"><SurgeDivider direction="horizontal" color="primary" size="sm" /></div>
          <span style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-size: 2.5rem; color: var(--color-ash-haze); opacity: 0.15; line-height: 1; display: block; margin-bottom: 1.5rem;">02</span>
          <h3 style="font-family: 'Neue Regrade', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--color-service-white); margin-bottom: 0.75rem;">Passion</h3>
          <p style="font-family: 'Avenir Next', sans-serif; font-size: 0.9375rem; line-height: 1.7; color: var(--color-ash-haze);">We ignite the champion within, at every level of the game.</p>
        </div>
        <!-- 03 Legacy -->
        <div class="group relative p-8 md:p-10" style="border: 1px solid var(--color-border); background: var(--color-bressel-black-soft);" data-aos="fade-up" data-aos-delay="300">
          <div class="mb-6"><SurgeDivider direction="horizontal" color="primary" size="sm" /></div>
          <span style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-size: 2.5rem; color: var(--color-ash-haze); opacity: 0.15; line-height: 1; display: block; margin-bottom: 1.5rem;">03</span>
          <h3 style="font-family: 'Neue Regrade', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--color-service-white); margin-bottom: 0.75rem;">Legacy</h3>
          <p style="font-family: 'Avenir Next', sans-serif; font-size: 0.9375rem; line-height: 1.7; color: var(--color-ash-haze);">Your journey extends beyond the court. A movement bigger than any match.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section style="background: var(--color-bressel-black-soft); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);" class="py-20 md:py-24">
    <div class="container-custom px-6 md:px-10 max-w-7xl mx-auto">
      <div class="grid grid-cols-3 gap-8 md:gap-16 text-center">
        <div data-aos="fade-up" data-aos-delay="100">
          <div style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-size: clamp(2.2rem, 4.5vw, 3.5rem); color: var(--color-bressel-red); line-height: 1;">500+</div>
          <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ash-haze);" class="block mt-2">Active Players</span>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-size: clamp(2.2rem, 4.5vw, 3.5rem); color: var(--color-bressel-red); line-height: 1;">50+</div>
          <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ash-haze);" class="block mt-2">Pro Coaches</span>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-size: clamp(2.2rem, 4.5vw, 3.5rem); color: var(--color-bressel-red); line-height: 1;">15</div>
          <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ash-haze);" class="block mt-2">Tournament Wins</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ QUOTE ═══ -->
  <section class="relative py-40 md:py-56 bg-bressel-black overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] flex items-center justify-center">
      <SurgeDivider direction="horizontal" color="primary" size="lg" />
    </div>
    <div class="container-custom px-6 md:px-10 max-w-5xl mx-auto text-center relative z-10">
      <div style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(1.6rem, 3.5vw, 2.8rem); line-height: 1.15; color: var(--color-service-white);" data-aos="fade-up">
        "Champions aren't made in comfort zones. They're forged in the fire of relentless pursuit."
      </div>
      <div class="flex items-center justify-center gap-4 mt-8" data-aos="fade-up" data-aos-delay="200">
        <div class="h-px w-8" style="background: var(--color-bressel-red);"></div>
        <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-ash-haze);">BRESSEL™ Mantra</span>
        <div class="h-px w-8" style="background: var(--color-bressel-red);"></div>
      </div>
    </div>
  </section>

  <!-- ═══ COACHES ═══ -->
  <section class="relative py-32 md:py-40" style="background: var(--color-bressel-black-soft);">
    <div class="container-custom px-6 md:px-10 max-w-7xl mx-auto">
      <div class="mb-16" data-aos="fade-up">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-8" style="background: var(--color-bressel-red);"></div>
          <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-bressel-red);">Meet the Squad</span>
        </div>
        <h2 style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1; letter-spacing: -0.01em; color: var(--color-service-white);">
          Coaches who <span style="color: var(--color-bressel-red);">inspire.</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        {coaches.map((c) => (
          <div class="relative" style="border: 1px solid var(--color-border); background: var(--color-bressel-black); overflow: hidden;" data-aos="fade-up">
            <div class="p-8 md:p-10">
              <div class="mb-6"><SurgeDivider direction="horizontal" color="primary" size="sm" /></div>
              <div style="font-family: 'Neue Regrade', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--color-service-white); margin-bottom: 0.25rem;">{c.name}</div>
              <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-bressel-red); display: block; margin-bottom: 0.5rem;">{c.role}</span>
              <p style="font-family: 'Avenir Next', sans-serif; font-size: 0.875rem; line-height: 1.7; color: var(--color-ash-haze);">{c.specialty}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="relative py-32 md:py-40 bg-bressel-black overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center" style="opacity: 0.02;">
      <div style="width: 600px; height: 600px; border: 1px solid var(--color-bressel-red); border-radius: 50%;"></div>
      <div style="width: 400px; height: 400px; border: 1px solid var(--color-bressel-red); border-radius: 50%; margin-left: -100px;"></div>
    </div>
    <div class="container-custom px-6 md:px-10 max-w-4xl mx-auto text-center relative z-10">
      <div data-aos="fade-up">
        <div class="flex items-center justify-center gap-4 mb-8">
          <div class="h-px w-10" style="background: var(--color-bressel-red);"></div>
          <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.5625rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-bressel-red);">Ready</span>
          <div class="h-px w-10" style="background: var(--color-bressel-red);"></div>
        </div>
        <h2 style="font-family: 'Neue Regrade', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 0.9; color: var(--color-service-white); margin-bottom: 1rem;">
          Your legacy<br /><span style="color: var(--color-bressel-red);">starts here.</span>
        </h2>
        <p class="mb-10 max-w-xl mx-auto" style="font-family: 'Avenir Next', sans-serif; font-size: 1.0625rem; line-height: 1.75; color: var(--color-ash-haze);">
          The court is waiting. Step into greatness today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/academy" class="inline-flex items-center justify-center gap-2 px-10 py-4 no-underline"
             style="background: var(--color-bressel-red); color: var(--color-service-white); font-family: 'Neue Regrade', sans-serif; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; transition: background 0.3s ease;">
            <span>Book Session</span>
            <Icon name="arrow-right" size={14} />
          </a>
          <a href="/contact" class="inline-flex items-center justify-center gap-2 px-10 py-4 no-underline"
             style="border: 2px solid var(--color-border); color: var(--color-service-white); font-family: 'Neue Regrade', sans-serif; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; transition: border 0.3s ease;">
            <span>Speak to a Coach</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>
