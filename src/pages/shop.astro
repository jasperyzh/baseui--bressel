---
/**
 * Shop Page - Full product catalog
 * Data: WordPress GraphQL (merch CPT)
 */
import MainLayout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import EmptyState from '@/components/EmptyState.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getMerch } from '@/lib/wordpress';
import { whatsappUrl } from '@/lib/config';

const products = await getMerch();

const hero = {
  label: 'BRESSEL PRO',
  title: 'Gear built for',
  highlight: 'the court',
  description: 'BRESSEL PRO equipment — engineered for precision. Inquire via WhatsApp.',
};
---

<MainLayout title="BRESSEL PRO — Shop" description="BRESSEL PRO equipment — engineered for precision.">
  <main class="pt-20 md:pt-24">
    <PageHero
      label={hero.label}
      title={hero.title}
      highlight={hero.highlight}
      description={hero.description}
      size="sm"
    />

    <!-- Products Grid -->
    <section class="section-py noise-overlay">
      <div class="container-custom">
        <div class="mb-12">
          <p class="caption mb-2">BRESSEL PRO</p>
          <h2>Featured <span class="text-bressel-red">drops</span></h2>
        </div>

        {products.length === 0 ? (
          <div class="max-w-2xl mx-auto">
            <EmptyState
              title="The catalog is being updated."
              description="New drops are coming. If you're looking for a specific racket or gear, message us and we'll check availability."
              ctaLabel="Inquire on WhatsApp"
              ctaHref={whatsappUrl("Hi BRESSEL! I'm looking for equipment. What's currently available?")}
            />
          </div>
        ) : (
          <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
            {products.map((product, i) => (
              <ProductCard product={product} delay={i * 80} />
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</MainLayout>
