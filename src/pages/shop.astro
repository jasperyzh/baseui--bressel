---
/**
 * Shop Page - Full product catalog
 * Data: WordPress GraphQL (merch CPT)
 */
import MainLayout from '@/layouts/Layout.astro';
import Button from '@/components/starwind/button/Button.astro';
import Card from '@/components/starwind/card/Card.astro';
import CardHeader from '@/components/starwind/card/CardHeader.astro';
import CardTitle from '@/components/starwind/card/CardTitle.astro';
import CardDescription from '@/components/starwind/card/CardDescription.astro';
import CardFooter from '@/components/starwind/card/CardFooter.astro';
import { getMerch } from '@/lib/wordpress';
import { whatsappUrl } from '@/lib/config';
import { fixImageUrl } from '@/lib/fix-image-url';
import type { Merch } from '@/lib/wordpress';

const products: Merch[] = await getMerch();

/** Strip HTML from WP content */
function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}
const hero = {
  label: 'BRESSEL PRO EQUIPMENT',
  title: 'THE',
  highlight: 'CATALOG',
  description: 'BRESSEL PRO equipment. Inquire via WhatsApp.',
};
---

<MainLayout title="BRESSEL Shop" description="BRESSEL PRO equipment - engineered for precision.">
  <main class="pt-20 md:pt-24">
    <!-- Hero -->
    <section class="relative min-h-[40vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, var(--color-background), var(--color-background), var(--color-muted));"></div>
      <div class="relative z-10 text-center px-6">
        <p class="caption mb-4">{hero.label}</p>
        <h1 class="mb-6">{hero.title} <span class="text-bressel-red">{hero.highlight}</span></h1>
        <p class="body-lg max-w-xl mx-auto">{hero.description}</p>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="py-20 noise-overlay">
      <div class="container-custom">
        <div class="mb-12">
          <p class="caption mb-2">ALL PRODUCTS</p>
          <h2>FEATURED <span class="text-bressel-red">DROPS</span></h2>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {products.map((product) => (
            <Card class="overflow-hidden group">
              <div class="relative aspect-square overflow-hidden bg-background">
                {fixImageUrl(product.featuredImage?.node?.sourceUrl) ? (
                  <img src={fixImageUrl(product.featuredImage.node.sourceUrl)} alt={product.title} class="w-full h-full object-contain p-6 transition-transform duration-500 group-hover:scale-105" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-muted-foreground font-header text-2xl font-black">{product.title.charAt(0)}</div>
                )}
              </div>
              <CardHeader>
                {product.merchSeries && (
                  <span class="inline-flex items-center gap-1.5 text-[0.625rem] font-bold uppercase tracking-wider mb-3 text-bressel-red">
                    <span class="w-1.5 h-1.5 inline-block bg-bressel-red"></span>
                    {product.merchSeries}
                  </span>
                )}
                <CardTitle class="font-header font-black italic text-lg uppercase text-foreground">{product.title}</CardTitle>
                <CardDescription class="body text-sm line-clamp-2">{stripHtml(product.content)}</CardDescription>
              </CardHeader>
              <CardFooter class="flex items-center justify-between bg-transparent border-t-0 p-6">
                <span class="font-header font-bold text-sm text-foreground">RM{product.merchPrice}</span>
                <a
                  href={whatsappUrl("Hi BRESSEL! I'm interested in " + product.title + ". Is it available?")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 uppercase no-underline transition-colors text-bressel-red"
                >
                  INQUIRE VIA WHATSAPP
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </a>
              </CardFooter>
            </Card>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
