---
/**
 * Newsletter CTA — "Stay in the Game"
 *
 * Clean, confident end-of-page conversion moment.
 * Net Black surface with subtle brand glow. No noise, no texture.
 * SURGE divider signals forward momentum. Scarlet CTA commands attention.
 */
import Button from '../starwind/button/Button.astro';
import Input from '../starwind/input/Input.astro';
import { WHATSAPP_NUMBER } from '../../lib/config';

const waPhone = WHATSAPP_NUMBER;
---

<section id="newsletter" class="relative py-28 md:py-36 overflow-hidden bg-bressel-black">

  <!-- Brand glow: radial red tint at top, fading to Net Black -->
  <div class="absolute inset-0 bg-page-hero"></div>

  <!-- SURGE divider — forward lean at top edge -->
  <div class="absolute top-0 left-0 right-0 flex justify-center">
    <div class="w-20 h-1 bg-bressel-red transform -skew-x-12"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container-custom text-center" data-aos="fade-up">

    <p class="caption mb-3">Stay connected</p>

    <h2 class="mb-6">
      Stay in the <span class="text-bressel-red">game</span>
    </h2>

    <p class="body-lg max-w-xl mx-auto mb-12 text-bressel-white/60">
      Gear drops, tournament invites, and stories from the court — message us to get on the list.
    </p>

    <!-- Form -->
    <form
      class="flex flex-col sm:flex-row gap-3 max-w-sm mx-auto"
      id="newsletter-cta"
      data-wa={waPhone}
    >
      <Input
        type="email"
        name="email"
        required
        placeholder="Email address"
        class="flex-1 bg-transparent !border !border-bressel-white/25 !text-bressel-white !text-sm !normal-case !font-body !tracking-normal !outline-none !placeholder:text-bressel-white/30 !focus:!border-bressel-red transition-colors h-12 px-4"
      />
      <Button
        type="submit"
        variant="primary"
        class="!bg-bressel-red !text-bressel-white hover:!bg-bressel-red-hover h-12 px-8"
        size="lg"
      >
        Subscribe
      </Button>
    </form>

  </div>
</section>

<script>
  const form = document.getElementById('newsletter-cta');
  if (form instanceof HTMLFormElement) {
    const waPhone = form.dataset.wa;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      if (!email || !waPhone) return;

      const msg = encodeURIComponent(
        `Hi BRESSEL! Please add me to the newsletter list.\n\nEmail: ${email}`
      );
      window.open(
        `https://wa.me/${waPhone}?text=${msg}`,
        '_blank',
        'noopener,noreferrer'
      );
      form.reset();
    });
  }
</script>
