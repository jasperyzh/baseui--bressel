---
/**
 * Newsletter CTA — "Stay in the Game."
 * Red band CTA at page bottom
 */
import Icon from '../Icon.astro';
import Button from '../starwind/button/Button.astro';
import Input from '../starwind/input/Input.astro';
---

<section id="newsletter" class="relative py-24 md:py-32 overflow-hidden">

  <!-- Dark Scarlet background with subtle noise texture -->
  <div class="absolute inset-0 bg-bressel-red"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-bressel-black/40 via-transparent to-bressel-black/40"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-bressel-red-hover/30 via-transparent to-bressel-red-hover/30"></div>

  <!-- Content -->
  <div class="relative z-10 container-custom text-center" data-aos="fade-up">

    <h2 class="heading-xl mb-6">
      Stay in the <span class="text-bressel-yellow">Game.</span>
    </h2>

    <p class="body-lg max-w-2xl mx-auto mb-10 text-bressel-white/80">
      Gear drops, tournament invites, stories from the court — straight to your inbox.
    </p>

    <!-- Email Form -->
    <form
      class="flex flex-col sm:flex-row gap-3 max-w-xl mx-auto"
      onsubmit="event.preventDefault(); alert('Subscribed!');"
    >
      <Input
        type="email"
        name="email"
        required
        placeholder="ENTER EMAIL"
        class="flex-1 bg-bressel-black/20 border-2 border-bressel-white/20 text-bressel-white text-xs font-bold uppercase tracking-wide outline-none placeholder:text-bressel-white/40 focus:border-bressel-white transition-colors"
      />
      <Button type="submit" variant="primary-solid" class="!bg-bressel-black !text-bressel-white hover:!bg-bressel-black/80 transition-transform hover:scale-[1.02]" size="lg">
        SUBSCRIBE
        <Icon name="mail" size={14} class="opacity-90" />
      </Button>
    </form>

  </div>

</section>
