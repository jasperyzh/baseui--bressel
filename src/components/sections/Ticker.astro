---
/**
 * Ticker — Scrolling news bar with seamless infinite loop.
 *
 * How it works:
 *   - Duplicate the item list so the track is exactly 2× the content.
 *   - Animate translateX from 0 → -50% (exactly one set of items).
 *   - At 50%, the duplicated items align perfectly with the originals → seamless wrap.
 *
 * Variants:
 *   variant="default" — edge-to-edge bar with top/bottom borders
 *   variant="fade"    — transparent bg + faded edges, for mid-page use
 *   variant="bare"    — no borders, no bg; fade mask only
 *
 * Props:
 *   items: TickerItem[]
 *   variant?: "default" | "fade" | "bare"
 *   speed?: number  — seconds for one full loop (default 40)
 */
interface TickerItem {
  label: string;
  value: string;
  labelColor?: "muted" | "primary";
}

interface Props {
  items?: TickerItem[];
  variant?: "default" | "fade" | "bare";
  speed?: number;
}

const {
  items = [
    { label: "UPCOMING:", value: "MALAYSIA OPEN QUALIFIERS", labelColor: "muted" },
    { label: "EVENT:", value: "BRESSEL JUNIOR PADEL CIRCUIT", labelColor: "primary" },
    { label: "LIVE:", value: "ACADEMY RANKING UPDATES", labelColor: "muted" },
    { label: "NEW DROP:", value: "PRECISION SERIES V2", labelColor: "muted" },
  ],
  variant = "default",
  speed = 55,
} = Astro.props;

// Duplicate for seamless loop
const loopItems = [...items, ...items];
---

<!-- Variant: default — bordered bar -->
{variant === "default" && (
  <div class="ticker-wrap ticker-default">
    <div class="ticker-track" style={`animation-duration: ${speed}s`}>
      {loopItems.map((item, i) => (
        <>
          <span class="ticker-item">
            <span class="ticker-label" style={`color: ${item.labelColor === "primary" ? "var(--color-bressel-red)" : "var(--color-bressel-grey)"};`}>
              {item.label}
            </span>
            <span class="ticker-value">{item.value}</span>
          </span>
          {i < loopItems.length - 1 && <span class="ticker-sep" aria-hidden="true">•</span>}
        </>
      ))}
    </div>
  </div>
)}

<!-- Variant: fade — transparent with edge fades -->
{variant === "fade" && (
  <div class="ticker-wrap ticker-fade">
    <div class="ticker-track" style={`animation-duration: ${speed}s`}>
      {loopItems.map((item, i) => (
        <>
          <span class="ticker-item">
            <span class="ticker-label" style={`color: ${item.labelColor === "primary" ? "var(--color-bressel-red)" : "var(--color-bressel-grey)"};`}>
              {item.label}
            </span>
            <span class="ticker-value">{item.value}</span>
          </span>
          {i < loopItems.length - 1 && <span class="ticker-sep" aria-hidden="true">•</span>}
        </>
      ))}
    </div>
  </div>
)}

<!-- Variant: bare — minimal, no decoration -->
{variant === "bare" && (
  <div class="ticker-wrap ticker-bare">
    <div class="ticker-track" style={`animation-duration: ${speed}s`}>
      {loopItems.map((item, i) => (
        <>
          <span class="ticker-item">
            <span class="ticker-label" style={`color: ${item.labelColor === "primary" ? "var(--color-bressel-red)" : "var(--color-bressel-grey)"};`}>
              {item.label}
            </span>
            <span class="ticker-value">{item.value}</span>
          </span>
          {i < loopItems.length - 1 && <span class="ticker-sep" aria-hidden="true">•</span>}
        </>
      ))}
    </div>
  </div>
)}

<style>
  .ticker-wrap {
    overflow: hidden;
    position: relative;
  }

  .ticker-default {
    background: var(--color-bressel-grey);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .ticker-fade::before,
  .ticker-fade::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4rem;
    z-index: 1;
    pointer-events: none;
  }

  .ticker-fade::before {
    left: 0;
    background: linear-gradient(to right, var(--color-background), transparent);
  }

  .ticker-fade::after {
    right: 0;
    background: linear-gradient(to left, var(--color-background), transparent);
  }

  .ticker-bare {
    /* No bg, no borders */
  }

  .ticker-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: ticker linear infinite;
    gap: 0;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 2rem;
    font-size: 0.6875rem;
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    flex-shrink: 0;
  }

  .ticker-value {
    color: var(--color-bressel-white);
  }

  .ticker-sep {
    color: var(--color-secondary);
    padding: 0 0.5rem;
    flex-shrink: 0;
  }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
      transform: none;
    }
  }
</style>