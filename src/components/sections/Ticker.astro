---
/**
 * Ticker — Scrolling announcement bar with seamless infinite loop.
 *
 * Data source: WordPress CMB2 options page → getTickerItems().
 * Callers should pass CMS items; the hardcoded array below is a fallback so
 * the ticker is never blank when WP is unreachable or no items are set.
 *
 * How the seamless loop works:
 *   - Render one set of items, then duplicate it enough times that one set
 *     overflows the viewport (≥2 copies; more if items are short/few).
 *   - Animate translateX 0 → -50%. At -50% the duplicated sets align with
 *     the originals → seamless wrap.
 *
 * Variants (wrapper only — track markup is shared):
 *   variant="default" — edge-to-edge bar with top/bottom borders
 *   variant="fade"    — transparent bg + faded edges, for mid-page use
 *   variant="bare"    — no borders, no bg; fade mask only
 *
 * Props:
 *   items?: TickerItem[]
 *   variant?: "default" | "fade" | "bare"
 *   loopSeconds?: number — seconds for one full loop (default 55)
 */
export interface TickerItem {
  label: string;
  value: string;
  isPrimary?: boolean;
}

interface Props {
  items?: TickerItem[];
  variant?: "default" | "fade" | "bare";
  loopSeconds?: number;
}

const {
  items = [
    { label: "EVENT", value: "Junior Padel Circuit — registration open", isPrimary: true },
    { label: "NEW", value: "Precision Series V2 drops this week" },
    { label: "LIVE", value: "Academy rankings updated" },
    { label: "COMMUNITY", value: "Open court nights every Friday" },
  ],
  variant = "default",
  loopSeconds = 55,
} = Astro.props;

// Only render items that have a value. Ensure ≥2 copies for a seamless loop;
// bump copies when there are few/short items so one set overflows the viewport.
const clean = items.filter((i) => i.value?.trim());
const copies = clean.length <= 3 ? 4 : 2;
const loopItems = Array.from({ length: copies }, () => clean).flat();

const wrapClass = {
  default: "ticker-default",
  fade: "ticker-fade",
  bare: "ticker-bare",
}[variant];
---

<div class={`ticker-wrap ${wrapClass}`} role="marquee" aria-label="Announcements">
  <div class="ticker-track" style={`animation-duration: ${loopSeconds}s`}>
    {loopItems.map((item, i) => (
      <span class="ticker-item" aria-hidden={i >= clean.length ? "true" : undefined}>
        {item.label && (
          <span class={`ticker-label ${item.isPrimary ? "ticker-label--primary" : ""}`}>
            {item.label}
          </span>
        )}
        <span class="ticker-value">{item.value}</span>
        {i < loopItems.length - 1 && <span class="ticker-sep" aria-hidden="true"></span>}
      </span>
    ))}
  </div>
</div>

<style>
  .ticker-wrap {
    overflow: hidden;
    position: relative;
  }

  /* ── Variants (wrapper only) ── */
  .ticker-default {
    background: var(--color-bressel-grey);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .ticker-fade::before,
  .ticker-fade::after,
  .ticker-bare::before,
  .ticker-bare::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4rem;
    z-index: 1;
    pointer-events: none;
  }
  .ticker-fade::before,
  .ticker-bare::before {
    left: 0;
    background: linear-gradient(to right, var(--color-background), transparent);
  }
  .ticker-fade::after,
  .ticker-bare::after {
    right: 0;
    background: linear-gradient(to left, var(--color-background), transparent);
  }
  .ticker-default::before,
  .ticker-default::after { display: none; }

  /* ── Track ── */
  .ticker-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: ticker linear infinite;
    gap: 0;
    width: max-content;
  }

  /* Pause on hover so users can read an item */
  .ticker-wrap:hover .ticker-track,
  .ticker-wrap:focus-within .ticker-track {
    animation-play-state: paused;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    font-size: 0.6875rem;
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    flex-shrink: 0;
  }

  .ticker-label {
    color: var(--color-bressel-grey);
  }
  .ticker-label--primary {
    color: var(--color-bressel-red);
  }

  .ticker-value {
    color: var(--color-bressel-white);
  }

  /* SURGE separator — small Scarlet square, sharp (replaces the • bullet) */
  .ticker-sep {
    width: 5px;
    height: 5px;
    background: var(--color-bressel-red);
    flex-shrink: 0;
    margin: 0 0.5rem;
  }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
      transform: none;
    }
  }
</style>
