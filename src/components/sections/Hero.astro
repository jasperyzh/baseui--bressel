---
import { Icon } from "astro-icon/components";
import WhatsAppButton from "../WhatsAppButton.astro";
import BresselCta from "../BresselCta.astro";
import { BRAND_YEAR } from "../../lib/config";

/**
 * Hero - Full-screen video/image background
 * Brand voice: Option A - Community-First (Play Beyond)
 * Tagline: EST. 2026 / PLAY BEYOND
 * Headline: Every Player Has a Place Here.
 * Dual CTAs: Start Your Journey (WhatsApp) + See How It Works (scroll)
 */
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
>
  <!-- Background Video - let the image breathe at 65% opacity -->
  <video
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 w-full h-full object-cover opacity-65"
    poster="/assets/hero-bg.webp"
  >
    <source src="/assets/background-video.mp4" type="video/mp4" />
  </video>

  <!-- Cinematic gradient: darker top (header legibility) + darker bottom (text legibility) -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-black/80"
  >
  </div>
  <!-- Subtle vignette for image framing -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(0,0,0,0.55)_100%)]"
  >
  </div>

  <!-- Content - vertically centered, leaves room for scroll indicator below -->
  <div class="container-custom w-full">
    <div
      class="relative z-10 px-6 pt-24 max-w-6xl"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <!-- EST / tagline -->
      <div class="flex items-center gap-4 mb-6">
        <div class="w-8 h-0.5 bg-bressel-red"></div>
        <span class="font-display">EST. {BRAND_YEAR} / PLAY BEYOND</span>
        <!-- <div class="w-8 h-0.5 bg-bressel-red"></div> -->
      </div>

      <!-- Headline -->
      <h1>
        Every Player Has<br />
        <span class="text-bressel-red">a Place Here</span>
      </h1>

      <!-- Body copy -->
      <p class="body-lg max-w-2xl mb-8">
        <span class="font-bold">World-class padel coaching</span> built around community.
        From your first swing to tournament day - we're in it together.
      </p>

      <!-- Dual CTAs -->
      <div class="flex flex-col sm:flex-row gap-4">
        <WhatsAppButton
          message="Hi BRESSEL! I'd like to start my padel journey. Could you share more about getting started?"
          variant="primary"
          size="lg"
        >
          Start Your Journey
        </WhatsAppButton>
        <BresselCta
          href="#essence"
          variant="outline"
          class="border-[#52525b] text-bressel-white hover:border-bressel-red hover:text-bressel-red"
        >
          See How It Works
        </BresselCta>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#essence"
    aria-label="Scroll to next section"
    class="absolute bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 no-underline group"
    data-aos="fade-up"
    data-aos-delay="800"
  >
    <span
      class="caption text-ash-haze group-hover:text-bressel-red transition-colors"
      >SCROLL TO BEGIN</span
    >
    <span class="animate-bounce">
      <Icon
        name="chevron-down"
        size={16}
        class="text-ash-haze group-hover:text-bressel-red transition-colors"
      />
    </span>
  </a>
</section>
