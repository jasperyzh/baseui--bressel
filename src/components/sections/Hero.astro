---
import { Icon } from "astro-icon/components";
import WhatsAppButton from "../WhatsAppButton.astro";
import BresselCta from "../BresselCta.astro";
import { BRAND_YEAR } from "../../lib/config";

/**
 * Hero - Full-screen video/image background
 * Brand voice: Option A - Community-First (Play Beyond)
 * Tagline: EST. 2026 / PLAY BEYOND
 * Headline: Every Player Has a Place Here.
 * Dual CTAs: Start Your Journey (WhatsApp) + See How It Works (scroll)
 */
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
>
  <!-- Background Video — 1280x720, blurred via CSS (hides source softness, aids text legibility).
       scale-105 so blur edges stay off-screen. WebM (VP9) first for better compression, MP4 fallback. -->
  <video
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    class="absolute inset-0 w-full h-full object-cover opacity-60 scale-105 [filter:blur(3px)]"
    poster="/assets/hero-bg.webp"
  >
    <source src="/assets/hero-bg.webm" type="video/webm" />
    <source src="/assets/hero-bg.mp4" type="video/mp4" />
  </video>

  <!-- Cinematic gradient: darker top (header legibility) + darker bottom (text legibility) -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/30 to-black/85"
  >
  </div>
  <!-- Subtle vignette for image framing -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(0,0,0,0.6)_100%)]"
  >
  </div>

  <!-- Content - vertically centered, leaves room for scroll indicator below -->
  <div class="container-custom w-full">
    <div
      class="relative z-10 px-6 pt-24 max-w-6xl"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <!-- EST / tagline -->
      <div class="flex items-center gap-4 mb-6 halo-trim">
        <div class="surge-divider"></div>
        <span class="caption">EST. {BRAND_YEAR} / PLAY BEYOND</span>
      </div>

      <!-- Headline — Neue Regrade Bold, sentence case (brand voice: Direct, Human) -->
      <h1>
        Every player counts<br />
        <span class="text-bressel-red italic">PLAY BEYOND</span>
      </h1>

      <!-- Body copy — one breath, one clear idea -->
      <p class="body-lg max-w-xl mb-8">
        Coach-led padel, built around people who love the game.
        Train the right way, from your first swing onward.
      </p>

      <!-- Dual CTAs -->
      <div class="flex flex-col sm:flex-row gap-4">
        <WhatsAppButton
          message="Hi BRESSEL! I'd like to start my padel journey. Could you share more about getting started?"
          variant="primary"
          size="lg"
        >
          Start Your Journey
        </WhatsAppButton>
        <BresselCta
          href="#essence"
          variant="outline"
          class="border-border text-bressel-white hover:border-bressel-red hover:text-bressel-red"
        >
          See How It Works
        </BresselCta>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#essence"
    aria-label="Scroll to next section"
    class="absolute bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 no-underline group"
    data-aos="fade-up"
    data-aos-delay="800"
  >
    <span
      class="caption text-muted-text group-hover:text-bressel-red transition-colors"
      >SCROLL TO BEGIN</span
    >
    <span class="animate-bounce">
      <Icon
        name="chevron-down"
        size={16}
        class="text-muted-text group-hover:text-bressel-red transition-colors"
      />
    </span>
  </a>
</section>
