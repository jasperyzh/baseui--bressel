---
/**
 * Community Voices — Authentic player testimonials, not poetic coach quotes
 * Section: VOICES FROM THE COURT
 * 2 player testimonials + 1 coach perspective
 */
const voices = [
  {
    text: "I started with zero padel experience. Six months later, I qualified for my first tournament. The coaches actually listened.",
    author: "AARON TAN",
    role: "PLAYER, BEGINNER TO COMPETITIVE",
    image: "/assets/quote-bg-silhouette.jpg"
  },
  {
    text: "It's not just about getting better. It's about the people you meet. My match friends have become my training friends.",
    author: "MAYA S.",
    role: "PLAYER, COMMUNITY MEMBER",
    image: "/assets/quote-bg-silhouette.jpg"
  },
  {
    text: "The BRESSEL methodology changed how I teach. It's about building confidence that lasts off court too.",
    author: "DARREN LEE",
    role: "COACH, BRESSEL CERTIFIED",
    image: "/assets/quote-bg-silhouette.jpg"
  }
];
---

<section id="voices" class="relative py-24 md:py-32 overflow-hidden">
  <div class="container-custom">

    <!-- Section Header -->
    <div class="mb-12">
      <p class="caption mb-2">Real Players. Real Stories.</p>
      <h2 class="heading-lg">VOICES FROM <span class="text-bressel-red">THE COURT.</span></h2>
    </div>

    {voices.map((voice, i) => (
      <div class={`relative mb-20 last:mb-0 ${i % 2 === 1 ? 'md:ml-16' : 'md:mr-16'}`} data-aos="fade-up" data-aos-delay={String(i * 100)}>
        <!-- Subtle texture background instead of dimmed photo -->
        <div class="absolute inset-0 bg-bressel-black-soft opacity-50 rounded-sm"></div>

        <div class="relative z-10 px-6 py-10 md:px-12 md:py-14">
          <!-- Quote mark -->
          <svg width="32" height="20" viewBox="0 0 20 14" fill="currentColor" class="text-bressel-red mb-6 opacity-80">
            <rect x="0" y="0" width="20" height="5" rx="2" />
            <rect x="0" y="9" width="20" height="5" rx="2" />
          </svg>

          <blockquote class="quote-text mb-8 max-w-3xl">
            &ldquo;{voice.text}&rdquo;
          </blockquote>

          <div class="flex items-center gap-3">
            <div class="w-8 h-0.5 bg-bressel-red"></div>
            <div>
              <p class="font-header font-bold text-[0.75rem] uppercase tracking-widest text-bressel-white">
                {voice.author}
              </p>
              <p class="text-[0.625rem] font-medium uppercase tracking-wider text-bressel-zinc-500">
                {voice.role}
              </p>
            </div>
          </div>
        </div>
      </div>
    ))}

  </div>
</section>
