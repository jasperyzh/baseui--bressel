---
/**
 * Community Voices - Carousel of testimonials with full-bleed background images.
 * Each slide: hero-style background image + dark gradient overlay + quote content.
 * Uses Starwind Carousel (Embla) with autoplay via setInterval.
 */
import { Icon } from 'astro-icon/components';
import Carousel from '../starwind/carousel/Carousel.astro';
import CarouselContent from '../starwind/carousel/CarouselContent.astro';
import CarouselItem from '../starwind/carousel/CarouselItem.astro';
import CarouselPrevious from '../starwind/carousel/CarouselPrevious.astro';
import CarouselNext from '../starwind/carousel/CarouselNext.astro';

const voices = [
  {
    text: "I started with zero padel experience. Six months later, I qualified for my first tournament. The coaches actually listened.",
    author: "AARON TAN*",
    role: "PLAYER, BEGINNER TO COMPETITIVE",
    image: "/assets/scholarship_kids/sponsorship_kids--Bressel-8528-cropped.webp",
  },
  {
    text: "It's not just about getting better. It's about the people you meet. My match friends have become my training friends.",
    author: "MAYA S.*",
    role: "PLAYER, COMMUNITY MEMBER",
    image: "/assets/national_team/nationalteam_group--Bressel-7515--cropped.webp",
  },
  {
    text: "The BRESSEL methodology changed how I teach. It's about building confidence that lasts off court too.",
    author: "Alicia T.*",
    role: "COACH, BRESSEL CERTIFIED",
    image: "/assets/coach/coach--Bressel-7933--cropped.webp",
  },
];
---

<section id="voices" class="relative py-20 md:py-28 overflow-hidden">
  <div class="container-custom">

    <!-- Section Header -->
    <div class="mb-10 md:mb-14">
      <p class="caption mb-2">Real Players. Real Stories.</p>
      <h2>VOICES FROM <span class="text-bressel-red">THE COURT</span></h2>
    </div>

    <!-- Carousel -->
    <Carousel
      class="voices-carousel relative"
      opts={{ loop: true, align: "start" }}
      autoInit={false}
      data-autoplay="6000"
    >
      <CarouselContent>
        {voices.map((voice, i) => (
          <CarouselItem>
            <article
              class="relative overflow-hidden min-h-[28rem] md:min-h-[32rem] flex items-end"
              data-aos="fade-up"
              data-aos-delay={String(i * 80)}
            >
              <!-- Background image -->
              <img
                src={voice.image}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover"
                loading={i === 0 ? "eager" : "lazy"}
              />
              <!-- Dark gradient overlay for legibility -->
              <div class="absolute inset-0 bg-gradient-to-t from-bressel-black via-bressel-black/70 to-bressel-black/20"></div>
              <div class="absolute inset-0 bg-gradient-to-r from-bressel-black/80 via-transparent to-transparent"></div>

              <!-- Content -->
              <div class="relative z-10 px-6 py-10 md:px-14 md:py-16 max-w-3xl">
                <Icon name="quote" size={32} class="text-bressel-red mb-5 opacity-90" />
                <blockquote class="quote-text mb-8">
                  &ldquo;{voice.text}&rdquo;
                </blockquote>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-0.5 bg-bressel-red"></div>
                  <div>
                    <p class="font-header font-bold text-[0.75rem] uppercase tracking-widest text-bressel-white">
                      {voice.author}
                    </p>
                    <p class="text-[0.625rem] font-medium uppercase tracking-wider text-ash-haze">
                      {voice.role}
                    </p>
                  </div>
                </div>
              </div>
            </article>
          </CarouselItem>
        ))}
      </CarouselContent>

      <!-- Controls -->
      <CarouselPrevious class="!left-4 md:!left-6 !bg-bressel-black/60 !border-bressel-white/30 !text-bressel-white hover:!bg-bressel-red hover:!border-bressel-red hover:!text-bressel-white !rounded-none !size-10" />
      <CarouselNext class="!right-4 md:!right-6 !bg-bressel-black/60 !border-bressel-white/30 !text-bressel-white hover:!bg-bressel-red hover:!border-bressel-red hover:!text-bressel-white !rounded-none !size-10" />

      <!-- Dot indicators -->
      <div class="voices-dots flex items-center justify-center gap-2 mt-6" role="tablist" aria-label="Testimonial navigation">
        {voices.map((_, i) => (
          <button
            type="button"
            class="voices-dot w-8 h-0.5 bg-bressel-zinc-700 hover:bg-ash-haze transition-colors"
            data-index={i}
            aria-label={`Go to testimonial ${i + 1}`}
          ></button>
        ))}
      </div>
    </Carousel>

  </div>
</section>

<script>
  import { initCarousel } from '../starwind/carousel/carousel-script';

  // Manual init so we can capture the Embla API for autoplay + dot sync.
  function setupVoicesCarousel() {
    const root = document.querySelector<HTMLElement>('.voices-carousel');
    if (!root || root.dataset.initialized === 'true') return;

    const dots = root.querySelectorAll<HTMLButtonElement>('.voices-dot');
    const autoplayMs = Number(root.getAttribute('data-autoplay') || '0');

    const manager = initCarousel(root, {
      setApi: (api) => {
        // Sync dot states
        const updateDots = () => {
          const idx = api.selectedScrollSnap();
          dots.forEach((d, i) => {
            d.classList.toggle('bg-bressel-red', i === idx);
            d.classList.toggle('bg-bressel-zinc-700', i !== idx);
          });
        };
        updateDots();
        api.on('select', updateDots);
        api.on('reInit', updateDots);

        // Dot click handlers
        dots.forEach((d, i) => {
          d.addEventListener('click', () => api.scrollTo(i));
        });

        // Autoplay with hover / focus / offscreen pausing
        if (autoplayMs > 0) {
          let timer: number | undefined;
          const play = () => {
            if (timer) return;
            timer = window.setInterval(() => api.scrollNext(), autoplayMs);
          };
          const pause = () => {
            if (timer) { window.clearInterval(timer); timer = undefined; }
          };

          root.addEventListener('mouseenter', pause);
          root.addEventListener('mouseleave', play);
          root.addEventListener('focusin', pause);
          root.addEventListener('focusout', play);

          const io = new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting) play(); else pause();
          }, { threshold: 0.1 });
          io.observe(root);
        }
      },
    });

    if (!manager) {
      console.warn('[voices-carousel] init failed');
    }
  }

  document.addEventListener('DOMContentLoaded', setupVoicesCarousel);
  document.addEventListener('astro:after-swap', setupVoicesCarousel);
</script>
