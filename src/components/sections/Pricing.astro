---
/**
 * Pricing — Rough overview with PDF download
 * Brand voice: Transparent, human, "from" pricing
 * Client direction: Show rough pricing on landing page, offer PDF for details
 */
---

<section id="pricing" class="py-24 bg-bressel-white text-bressel-black">
  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-12" data-aos="fade-up">
      <p class="caption text-bressel-zinc-600 mb-2">INVESTMENT</p>
      <h2 class="heading-lg text-bressel-black">
        TRAINING <span class="text-bressel-red">PROGRAMS.</span>
      </h2>
    </div>

    <!-- Pricing Table -->
    <div class="max-w-2xl mx-auto">
      <div class="border border-bressel-zinc-800/20 divide-y divide-bressel-zinc-800/10">
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Individual Sessions</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 120/session</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Group Training</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 60/session</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Monthly Packages</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 450/month</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Competition Program</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 280/session</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Coach Certification</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 899/course</span>
        </div>
      </div>

      <!-- Disclaimer -->
      <p class="body text-sm text-bressel-zinc-600 mt-4 mb-8 text-center">
        Pricing varies based on level, schedule, and program length.
      </p>

      <!-- PDF Download & WhatsApp CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/assets/pricing-bressel.pdf"
          download
          class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-bressel-red text-bressel-white font-header font-bold text-[0.6875rem] uppercase tracking-wide no-underline transition-colors hover:bg-bressel-red-hover"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Download Full Pricing (PDF)
        </a>
        <a
          href="https://wa.me/60123456789?text=Hi%20BRESSEL!%20I'd%20like%20to%20know%20more%20about%20your%20pricing%20and%20programs."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-3 border-2 border-bressel-black text-bressel-black font-header font-bold text-[0.6875rem] uppercase tracking-wide no-underline transition-colors hover:bg-bressel-black hover:text-bressel-white"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Ask on WhatsApp
        </a>
      </div>
    </div>

  </div>
</section>
