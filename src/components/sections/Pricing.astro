---
/**
 * Pricing - Rough overview with PDF download
 * Brand voice: Transparent, human, "from" pricing
 * Client direction: Show rough pricing on landing page, offer PDF for details
 */
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../../lib/config';
import BresselCta from '../BresselCta.astro';
---

<section id="pricing" class="py-24 bg-bressel-white text-bressel-black relative overflow-hidden">
  <!-- Background: minimal court photo -->
  <img
    src="/assets/brandvisual--/20260402_115035.webp"
    alt=""
    class="absolute inset-0 w-full h-full object-cover opacity-20"
  />
  <div class="container-custom relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-12" data-aos="fade-up">
      <p class="caption text-muted-foreground mb-2">INVESTMENT</p>
      <h2 class="text-bressel-black">
        TRAINING <span class="text-bressel-red">PROGRAMS</span>
      </h2>
    </div>

    <!-- Pricing Table -->
    <div class="max-w-2xl mx-auto">
      <div class="border border-[#27272a]/20 divide-y divide-bressel-zinc-800/10">
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Individual Sessions</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 120/session</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Group Training</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 60/session</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Monthly Packages</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 450/month</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Competition Program</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 280/session</span>
        </div>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="font-header font-bold uppercase tracking-wide text-sm">Coach Certification</span>
          <span class="font-header font-black text-lg text-bressel-red">from RM 899/course</span>
        </div>
      </div>

      <!-- Disclaimer -->
      <p class="body text-sm text-muted-foreground mt-4 mb-8 text-center">
        Pricing varies based on level, schedule, and program length.
      </p>

      <!-- PDF Download & WhatsApp CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <BresselCta href="/assets/pricing-bressel.pdf" variant="primary" download={true}>
          <Icon name="download" size={14} />
          Download Full Pricing (PDF)
        </BresselCta>
        <BresselCta
          href={whatsappUrl("Hi BRESSEL! I'd like to know more about your pricing and programs.")}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          class="border-bressel-black text-bressel-black hover:bg-bressel-black hover:text-bressel-white"
        >
          <Icon name="whatsapp" size={14} />
          Ask on WhatsApp
        </BresselCta>
      </div>
    </div>

  </div>
</section>
