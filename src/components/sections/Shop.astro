---
/**
 * Shop — Product grid with "BRESSEL PRO" watermark
 * Mockup: 2 visible products (BRESSEL PADEL-X, KINETIC GRIP-V1), VISIT CATALOG CTA
 */
import products from '../../content/merch.json';
import Card from '../starwind/card/Card.astro';
import Button from '../starwind/button/Button.astro';
import CardHeader from '../starwind/card/CardHeader.astro';
import CardTitle from '../starwind/card/CardTitle.astro';
import CardDescription from '../starwind/card/CardDescription.astro';
import CardContent from '../starwind/card/CardContent.astro';
import CardFooter from '../starwind/card/CardFooter.astro';
import ArrowRight from '../icons/ArrowRight.astro';
---

<section id="shop" class="py-20 noise-overlay relative overflow-hidden">
  <div class="container-custom">

    <!-- Ghost watermark -->
    <div class="absolute top-8 right-8 font-header font-black italic text-6xl md:text-8xl text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.03);">BRESSEL PRO</div>

    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <p class="caption mb-2">Engineered for communities and beyond.</p>
        <h2 class="heading-lg">SHOP</h2>
      </div>
      <a
          href="https://wa.me/60123456789?text=Hi%20BRESSEL!%20I'm%20interested%20in%20your%20equipment.%20Is%20it%20available?"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-bressel-red text-bressel-white font-header font-bold text-[0.6875rem] uppercase tracking-wide no-underline transition-colors hover:bg-bressel-red-hover"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          VISIT CATALOG
        </a>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">

      {products.map((product, i) => (
        <Card class="overflow-hidden transition-colors duration-300 group" data-aos="fade-up" data-aos-delay={String(i * 100)}>
          <!-- Product Image -->
          <div class="relative aspect-square overflow-hidden bg-bressel-black">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
              data-swap={product.swapId}
            />
          </div>

          <!-- Product Body -->
          <CardHeader>
            <span class="inline-flex items-center gap-1.5 text-[0.625rem] font-bold uppercase tracking-wider text-bressel-red mb-3">
              <span class="w-1.5 h-1.5 bg-bressel-red inline-block"></span>
              {product.series}
            </span>
            <CardTitle class="font-header font-black italic text-lg uppercase text-bressel-white">
              {product.name}
            </CardTitle>
            <CardDescription class="body text-sm line-clamp-2">
              {product.description}
            </CardDescription>
          </CardHeader>

          <!-- Price + CTA -->
          <CardFooter class="flex items-center justify-between bg-transparent border-t-0 p-6">
            <span class="font-header font-bold text-sm text-bressel-white">
              RM{product.price}
            </span>
            <a
              href={`https://wa.me/60123456789?text=${encodeURIComponent("Hi BRESSEL! I'm interested in " + product.name + ". Is it available?")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-bressel-zinc-400 font-header font-bold text-[0.625rem] uppercase tracking-wide hover:text-bressel-white transition-colors no-underline"
            >
              INQUIRE
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </CardFooter>
        </Card>
      ))}

    </div>

  </div>
</section>
