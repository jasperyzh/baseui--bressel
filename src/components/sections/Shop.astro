---
/**
 * Shop - Product grid with "BRESSEL PRO" watermark (homepage teaser)
 * Props: products array from WordPress GraphQL (merch CPT)
 */
import type { Merch } from '../../lib/wordpress';
import { whatsappUrl } from '../../lib/config';
import { Icon } from 'astro-icon/components';
import BresselCta from '../BresselCta.astro';
import ProductCard from '../ProductCard.astro';

interface Props {
  products: Merch[];
}

const { products } = Astro.props;
---

<section id="shop" class="section-py noise-overlay relative overflow-hidden">
  <div class="container-custom">

    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <p class="caption mb-2">BRESSEL PRO</p>
        <h2>Shop the catalog</h2>
        <div class="surge-divider mt-4"></div>
      </div>
      <BresselCta href="/shop" variant="primary">
        Visit catalog
      </BresselCta>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 relative z-10">
      {products.map((product, i) => (
        <ProductCard product={product} delay={i * 80} />
      ))}
    </div>

  </div>
</section>
