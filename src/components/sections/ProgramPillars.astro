---
/**
 * Program Pillars - 3 image cards with overlay text
 * Brand voice: Option A
 * PLAY BEYOND - The Competitive Edge
 * GO BEYOND - Build the Team
 * GROW BEYOND - Train the Next Generation
 */
import Card from '../starwind/card/Card.astro';
import CardContent from '../starwind/card/CardContent.astro';
import CardHeader from '../starwind/card/CardHeader.astro';
import CardTitle from '../starwind/card/CardTitle.astro';
import CardDescription from '../starwind/card/CardDescription.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
---

<section id="programs" class="py-28 relative overflow-hidden">
  <div class="container-custom">

    <!-- Section Header -->
    <div class="mb-12">
      <p class="caption mb-2">Built around people who love the game.</p>
      <h2>PROGRAM PILLARS</h2>
    </div>

    <!-- Ghost watermark -->
    <div class="watermark-ghost absolute top-8 left-8">BEYOND</div>

    <!-- Three Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">

      <!-- PLAY BEYOND -->
      <Card class="card-full-bleed relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up">
        <img
          src="/assets/national_team/nationalteam--Bressel-6995--cropped.webp"
          alt="Professional Training"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          data-swap="professional"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <CardContent class="absolute inset-x-0 bottom-0">
          <CardHeader>
            <span class="inline-flex items-center gap-1.5 text-[0.625rem] font-bold uppercase tracking-wider text-bressel-red mb-3">
              <span class="w-2 h-2 bg-bressel-red inline-block"></span>
              PLAY BEYOND
            </span>
            <CardTitle>The Competitive Edge</CardTitle>
            <CardDescription class="body text-sm">
              One-on-one coaching, match strategy, tournament prep.
            </CardDescription>
          </CardHeader>
          <WhatsAppButton
            message="Hi BRESSEL! I'm interested in the Professional training program. Could you tell me more?"
            variant="outline"
            size="sm"
            class="mt-4"
          >
            Inquire
          </WhatsAppButton>
        </CardContent>
      </Card>

      <!-- GO BEYOND -->
      <Card class="card-full-bleed relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up" data-aos-delay="150">
        <img
          src="/assets/national_team/nationalteam--Bressel-7129--cropped.webp"
          alt="Competition"
          class="absolute inset-0 w-full h-full object-cover object-center bg-bressel-black-soft transition-transform duration-500 group-hover:scale-105"
          data-swap="competition"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <CardContent class="absolute inset-x-0 bottom-0">
          <CardHeader>
            <span class="inline-flex items-center gap-1.5 text-[0.625rem] font-bold uppercase tracking-wider text-bressel-red mb-3">
              <span class="w-2 h-2 bg-bressel-red inline-block"></span>
              GO BEYOND
            </span>
            <CardTitle>Build the Team</CardTitle>
            <CardDescription class="body text-sm">
              Circuit play, team ladders, regional tournaments.
            </CardDescription>
          </CardHeader>
          <WhatsAppButton
            message="Hi BRESSEL! I'm interested in the Competition program. How do I join?"
            variant="outline"
            size="sm"
            class="mt-4"
          >
            Inquire
          </WhatsAppButton>
        </CardContent>
      </Card>

      <!-- GROW BEYOND -->
      <Card class="card-full-bleed relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up" data-aos-delay="300">
        <img
          src="/assets/scholarship_kids/sponsorship_kids--Bressel-8591--cropped.webp"
          alt="Coaches Certification"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          data-swap="coaches"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <CardContent class="absolute inset-x-0 bottom-0">
          <CardHeader>
            <span class="inline-flex items-center gap-1.5 text-[0.625rem] font-bold uppercase tracking-wider text-ash-haze mb-3">
              <span class="w-2 h-2 bg-ash-haze inline-block"></span>
              GROW BEYOND
            </span>
            <CardTitle>Train the Next Generation</CardTitle>
            <CardDescription class="body text-sm">
              BRESSEL certification programs. Shape the sport's future.
            </CardDescription>
          </CardHeader>
          <WhatsAppButton
            message="Hi BRESSEL! I'm interested in coach certification. Could you share more details?"
            variant="outline"
            size="sm"
            class="mt-4"
          >
            Inquire
          </WhatsAppButton>
        </CardContent>
      </Card>

    </div>

  </div>
</section>
