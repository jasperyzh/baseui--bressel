---
/**
 * Visual Dev Tool - Image swap dev panel for Astro
 *
 * Usage:
 *   import VisualDev from '../components/visual-dev/VisualDev.astro';
 *   {import.meta.env.DEV && <VisualDev />}
 *
 * Props:
 *   library: string[] - optional image picker options
 *   pageGrouping: boolean - group slots by page (default: true)
 *   defaultView: 'component' | 'page' | 'flat' - default grouping (default: 'component')
 *
 * Tag your images:
 *   <img src="/assets/hero.jpg" data-swap="hero-bg" />
 *   <div data-swap="hero-bg" style="background-image: url('/assets/bg.jpg')" />
 */

const { library = [], pageGrouping = true, defaultView = 'component' } = Astro.props;
const isDev = import.meta.env.DEV;
---

{isDev && (
  <div id="visual-dev-wrapper">
    <!-- Floating Toggle Button -->
    <button
      id="vd-toggle"
      class="vd-toggle"
      title="Visual Dev Tool (V)"
      aria-label="Toggle Visual Dev Tool"
    >
      🎨
    </button>

    <!-- Main Panel -->
    <div id="vd-panel" class="vd-panel vd-surface">
      <div class="vd-header">
        <span class="vd-title">🎨 Visual Dev Tool</span>
        <div class="vd-header-actions">
          <select id="vd-page-select" class="vd-input vd-select" title="Select page">
            <option value="all">All Pages</option>
            <option value="/">Homepage</option>
            <option value="/about">About</option>
            <option value="/academy">Academy</option>
            <option value="/community">Community</option>
            <option value="/shop">Shop</option>
            <option value="/contact">Contact</option>
          </select>
          <select id="vd-view-select" class="vd-input vd-select" title="Grouping mode">
            <option value="component" selected>By Component</option>
            <option value="page">By Page</option>
            <option value="flat">Flat List</option>
          </select>
          <input id="vd-search" type="text" class="vd-input vd-search" placeholder="Search slots..." />
          <button id="vd-inspect-btn" class="vd-btn vd-btn-sm" title="Inspect Mode (I)">🔎 Inspect</button>
          <button id="vd-ghost-btn" class="vd-btn vd-btn-sm" title="Ghost Mode (G)">👻 Ghost</button>
          <button id="vd-clear-btn" class="vd-btn vd-btn-sm" title="Clear All Swaps">🗑 Clear</button>
          <button id="vd-close-btn" class="vd-btn vd-btn-sm" title="Close (ESC)">✕</button>
        </div>
      </div>

      <div id="vd-slots" class="vd-slots">
        <!-- Populated by JS -->
      </div>

      <div class="vd-footer">
        <button id="vd-export-json" class="vd-btn" title="Export JSON (E)">📤 Export JSON</button>
        <button id="vd-export-code" class="vd-btn" title="Copy Code (C)">📋 Copy Code</button>
        <button id="vd-export-diff" class="vd-btn" title="Copy Diff">📋 Copy Diff</button>
      </div>
    </div>

    <!-- Preview Modal -->
    <div id="vd-preview" class="vd-overlay">
      <div class="vd-card">
        <div class="vd-card-header">
          <span id="vd-preview-title" class="vd-preview-title"></span>
          <button id="vd-preview-close" class="vd-btn vd-btn-sm">✕</button>
        </div>
        <div class="vd-card-body">
          <div class="vd-preview-compare">
            <div>
              <div class="vd-label">Before</div>
              <img id="vd-preview-before" alt="Before" />
            </div>
            <div>
              <div class="vd-label">After</div>
              <img id="vd-preview-after" alt="After" />
            </div>
          </div>
          <div class="vd-preview-actions">
            <button id="vd-preview-prev" class="vd-btn vd-btn-sm">←</button>
            <button id="vd-preview-apply" class="vd-btn vd-btn-sm vd-btn-accent">✓ Apply</button>
            <button id="vd-preview-next" class="vd-btn vd-btn-sm">→</button>
            <button id="vd-preview-cancel" class="vd-btn vd-btn-sm">✗ Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Library Browser Modal -->
    <div id="vd-library" class="vd-overlay">
      <div class="vd-card">
        <div class="vd-card-header">
          <span>📷 Image Library</span>
          <button id="vd-library-close" class="vd-btn vd-btn-sm">✕</button>
        </div>
        <div id="vd-library-grid" class="vd-library-grid">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
)}

<script is:inline define:vars={{ defaultLibrary: library, defaultView: defaultView }}>
(() => {
  'use strict';

  const STORAGE_KEY = 'visual-dev-swaps';

  // ---- STATE ----
  const state = {
    isOpen: false,
    isGhost: false,
    isInspect: false,
    selectedSlot: null,
    previewingSlot: null,
    previewIndex: 0,
    library: JSON.parse(JSON.stringify(defaultLibrary || [])),
    viewMode: defaultView || 'component',
    pageFilter: 'all',
    searchQuery: '',
    autoImgCounter: 0,
  };

  // ---- DOM REFS ----
  const toggle = document.getElementById('vd-toggle');
  const panel = document.getElementById('vd-panel');
  const slotsEl = document.getElementById('vd-slots');
  const searchInput = document.getElementById('vd-search');
  const viewSelect = document.getElementById('vd-view-select');
  const pageSelect = document.getElementById('vd-page-select');
  const inspectBtn = document.getElementById('vd-inspect-btn');
  const ghostBtn = document.getElementById('vd-ghost-btn');
  const clearBtn = document.getElementById('vd-clear-btn');
  const closeBtn = document.getElementById('vd-close-btn');
  const exportJsonBtn = document.getElementById('vd-export-json');
  const exportCodeBtn = document.getElementById('vd-export-code');
  const exportDiffBtn = document.getElementById('vd-export-diff');
  const previewOverlay = document.getElementById('vd-preview');
  const previewBefore = document.getElementById('vd-preview-before');
  const previewAfter = document.getElementById('vd-preview-after');
  const previewTitle = document.getElementById('vd-preview-title');
  const previewApply = document.getElementById('vd-preview-apply');
  const previewCancel = document.getElementById('vd-preview-cancel');
  const previewPrev = document.getElementById('vd-preview-prev');
  const previewNext = document.getElementById('vd-preview-next');
  const previewClose = document.getElementById('vd-preview-close');
  const libraryOverlay = document.getElementById('vd-library');
  const libraryGrid = document.getElementById('vd-library-grid');
  const libraryClose = document.getElementById('vd-library-close');

  // ---- STORAGE ----
  function loadSwaps() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    } catch { return {}; }
  }

  function saveSwaps(swaps) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(swaps));
    } catch (e) {
      console.warn('[visual-dev] localStorage full:', e);
      flashMessage('⚠ Storage full - swaps may not persist');
    }
  }

  // ---- DOM SCAN ----
  function detectSlotType(el) {
    if (el.tagName === 'IMG') return 'img';
    if (el.tagName === 'VIDEO') return 'video';
    if (el.tagName === 'SOURCE') return 'source';
    if (el.style?.backgroundImage) return 'bg';
    return 'img';
  }

  function getCurrentPath(el, type) {
    if (type === 'img') return el.getAttribute('src') || '';
    if (type === 'video') return el.getAttribute('poster') || '';
    if (type === 'source') return el.getAttribute('src') || '';
    if (type === 'bg') {
      const m = el.style?.backgroundImage?.match(/url\(['"]?([^'"]+)['"]?\)/);
      return m?.[1] || '';
    }
    return '';
  }

  function createThumb(el, type) {
    if (type === 'img') return el.getAttribute('src') || null;
    if (type === 'video') return el.getAttribute('poster') || null;
    if (type === 'bg') {
      const m = el.style?.backgroundImage?.match(/url\(['"]?([^'"]+)['"]?\)/);
      return m?.[1] || null;
    }
    return null;
  }

  function scanSlots() {
    const swaps = loadSwaps();
    const slots = [];
    const els = document.querySelectorAll('[data-swap]');

    els.forEach((el) => {
      const slotId = el.getAttribute('data-swap');
      const type = detectSlotType(el);
      const currentPath = getCurrentPath(el, type);
      const hasSwap = swaps[slotId] && swaps[slotId] !== currentPath;
      const originalPath = el.getAttribute('data-swap-original') || currentPath;

      if (!el.hasAttribute('data-swap-original')) {
        el.setAttribute('data-swap-original', originalPath);
      }

      slots.push({
        id: slotId,
        type,
        element: el,
        currentPath,
        originalPath,
        hasSwap,
        thumbnail: createThumb(el, type),
      });
    });

    return slots;
  }

  // ---- APPLY / RESET ----
  function applySwap(slotId, newPath) {
    const el = document.querySelector(`[data-swap="${slotId}"]`);
    if (!el) return false;

    const type = detectSlotType(el);
    const swaps = loadSwaps();

    if (type === 'img') {
      el.setAttribute('src', newPath);
    } else if (type === 'video') {
      el.setAttribute('poster', newPath);
    } else if (type === 'source') {
      el.setAttribute('src', newPath);
    } else if (type === 'bg') {
      el.style.backgroundImage = `url('${newPath}')`;
    }

    swaps[slotId] = newPath;
    saveSwaps(swaps);
    return true;
  }

  function resetSlot(slotId) {
    const swaps = loadSwaps();
    delete swaps[slotId];
    saveSwaps(swaps);

    const el = document.querySelector(`[data-swap="${slotId}"]`);
    if (!el) return;

    const type = detectSlotType(el);
    const original = el.getAttribute('data-swap-original');
    if (!original) return;

    if (type === 'img') el.setAttribute('src', original);
    else if (type === 'video') el.setAttribute('poster', original);
    else if (type === 'source') el.setAttribute('src', original);
    else if (type === 'bg') el.style.backgroundImage = `url('${original}')`;
  }

  // ---- BASE64 CONVERSION (canvas compress) ----
  function fileToBase64(file) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(file);

      img.onload = () => {
        const MAX_DIM = 1920;
        let { width, height } = img;

        if (width > MAX_DIM || height > MAX_DIM) {
          const ratio = Math.min(MAX_DIM / width, MAX_DIM / height);
          width = Math.round(width * ratio);
          height = Math.round(height * ratio);
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        const dataUrl = canvas.toDataURL('image/webp', 0.8);
        URL.revokeObjectURL(url);
        resolve(dataUrl);
      };

      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('Failed to load image'));
      };

      img.src = url;
    });
  }

  // ---- RENDER ----
  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderSlot(slot) {
    return `
      <div class="vd-slot ${slot.hasSwap ? 'vd-slot-swapped' : ''} ${slot.id === state.selectedSlot ? 'vd-slot-selected' : ''}" data-slot="${slot.id}">
        <div class="vd-slot-header">
          ${slot.thumbnail ? `<img class="vd-slot-thumb" src="${slot.thumbnail}" alt="" loading="lazy" />` : '<div class="vd-slot-thumb vd-thumb-empty"></div>'}
          <div class="vd-slot-info">
            <span class="vd-slot-id">${slot.id}</span>
            <span class="vd-slot-path">${escapeHtml(slot.currentPath)}</span>
          </div>
          ${slot.hasSwap ? '<span class="vd-badge">✓</span>' : ''}
        </div>
        <div class="vd-slot-actions">
          <button class="vd-btn vd-btn-sm vd-swap-btn" data-action="browse" data-slot="${slot.id}" title="Browse library">📷</button>
          <button class="vd-btn vd-btn-sm vd-swap-btn" data-action="paste" data-slot="${slot.id}" title="Paste URL">🔗</button>
          <button class="vd-btn vd-btn-sm vd-swap-btn" data-action="reset" data-slot="${slot.id}" title="Reset (R)">↩</button>
          <button class="vd-btn vd-btn-sm vd-swap-btn" data-action="copy" data-slot="${slot.id}" title="Copy path">📋</button>
        </div>
      </div>`;
  }

  function renderSlots() {
    const slots = scanSlots();

    if (slots.length === 0) {
      slotsEl.innerHTML = `
        <div class="vd-empty">
          No <code>data-swap</code> tags found on this page.<br/>
          <span class="vd-hint">Add data-swap="your-id" to images you want to manage.</span>
        </div>`;
      return;
    }

    let filtered = slots;
    if (state.searchQuery) {
      const q = state.searchQuery.toLowerCase();
      filtered = slots.filter(s => s.id.toLowerCase().includes(q) || s.currentPath.toLowerCase().includes(q));
    }

    let html = '';
    if (state.viewMode === 'component') {
      const groups = {};
      filtered.forEach(s => {
        const group = s.id.split('-')[0];
        if (!groups[group]) groups[group] = [];
        groups[group].push(s);
      });
      Object.entries(groups).forEach(([group, gs]) => {
        html += `<div class="vd-group"><div class="vd-group-title">${group}</div>`;
        gs.forEach(s => { html += renderSlot(s); });
        html += '</div>';
      });
    } else if (state.viewMode === 'page') {
      html += `<div class="vd-group"><div class="vd-group-title">Current Page</div>`;
      filtered.forEach(s => { html += renderSlot(s); });
      html += '</div>';
    } else {
      filtered.forEach(s => { html += renderSlot(s); });
    }

    slotsEl.innerHTML = html;
  }

  // ---- PANEL ----
  function openPanel() {
    state.isOpen = true;
    panel.classList.add('vd-open');
    renderSlots();
  }

  function closePanel() {
    state.isOpen = false;
    panel.classList.remove('vd-open');
  }

  function togglePanel() {
    if (state.isOpen) closePanel(); else openPanel();
  }

  // ---- GHOST ----
  function toggleGhost() {
    state.isGhost = !state.isGhost;
    panel.classList.toggle('vd-ghost', state.isGhost);
    ghostBtn.classList.toggle('vd-active', state.isGhost);
  }

  // ---- INSPECT ----
  function toggleInspect() {
    state.isInspect = !state.isInspect;
    document.body.classList.toggle('vd-inspect-mode', state.isInspect);
    inspectBtn.classList.toggle('vd-active', state.isInspect);
    if (state.isInspect) closePanel();
  }

  // ---- PREVIEW ----
  function showPreview(slotId, newPath) {
    const slot = document.querySelector(`[data-swap="${slotId}"]`);
    if (!slot) return;

    state.previewingSlot = slotId;
    state.previewIndex = state.library.indexOf(newPath);
    if (state.previewIndex === -1) state.previewIndex = 0;
    previewTitle.textContent = slotId;

    const type = detectSlotType(slot);
    const thumb = createThumb(slot, type);
    previewBefore.src = thumb || '';
    previewAfter.src = newPath;

    previewOverlay.classList.add('vd-open');
  }

  function hidePreview() {
    previewOverlay.classList.remove('vd-open');
    state.previewingSlot = null;
  }

  // ---- LIBRARY ----
  function openLibrary(slotId) {
    state.selectedSlot = slotId;
    renderLibrary();
    libraryOverlay.classList.add('vd-open');
  }

  function closeLibrary() {
    libraryOverlay.classList.remove('vd-open');
    state.selectedSlot = null;
  }

  function renderLibrary() {
    if (state.library.length === 0) {
      libraryGrid.innerHTML = '<div class="vd-empty">No images in library.<br/>Pass <code>library={[...]}</code> to VisualDev component.</div>';
      return;
    }

    libraryGrid.innerHTML = state.library.map(img => `
      <div class="vd-lib-item" data-img="${img}">
        <img src="${img}" alt="" class="vd-lib-thumb" loading="lazy" />
        <span class="vd-lib-name">${img.split('/').pop()}</span>
      </div>
    `).join('');
  }

  // ---- EXPORT ----
  function exportJSON() {
    const swaps = loadSwaps();
    const data = {
      project: 'base-ui-starwind',
      version: '2.0',
      exported: new Date().toISOString(),
      swaps,
    };
    const json = JSON.stringify(data, null, 2);
    const blob = new Blob([json], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `visual-dev-${Date.now()}.json`;
    a.click();
    URL.revokeObjectURL(url);
    flashMessage('JSON exported!');
  }

  function exportCode() {
    const swaps = loadSwaps();
    let code = '';
    Object.entries(swaps).forEach(([id, path]) => {
      const el = document.querySelector(`[data-swap="${id}"]`);
      if (el) {
        const tag = el.tagName.toLowerCase();
        const pathAttr = tag === 'img' || tag === 'source' ? `src="${path}"` :
                         tag === 'video' ? `poster="${path}"` :
                         `style="background-image: url('${path}')"`;
        const typeAttr = tag === 'source' ? `type="${el.getAttribute('type') || ''}"` : '';
        code += `<${tag} ${pathAttr} data-swap="${id}" ${typeAttr} />\n`;
      } else {
        code += `<!-- data-swap="${id}" -->\n<img src="${path}" data-swap="${id}" />\n`;
      }
    });
    navigator.clipboard.writeText(code.trim()).then(() => {
      flashMessage('Code copied to clipboard!');
    });
  }

  function exportDiff() {
    const swaps = loadSwaps();
    let diff = '';
    Object.entries(swaps).forEach(([id, newPath]) => {
      const el = document.querySelector(`[data-swap="${id}"]`);
      const original = el ? (el.getAttribute('data-swap-original') || `/${id}.jpg`) : `/${id}.jpg`;
      diff += `${id}: ${original} → ${newPath}\n`;
    });
    navigator.clipboard.writeText(diff.trim()).then(() => {
      flashMessage('Diff copied to clipboard!');
    });
  }

  // ---- FLASH ----
  function flashMessage(text) {
    const msg = document.createElement('div');
    msg.className = 'vd-flash';
    msg.textContent = text;
    document.body.appendChild(msg);
    requestAnimationFrame(() => msg.classList.add('vd-flash-show'));
    setTimeout(() => {
      msg.classList.remove('vd-flash-show');
      setTimeout(() => msg.remove(), 300);
    }, 2000);
  }

  // ---- DRAG & DROP ----
  async function handleDrop(slotId, file) {
    if (!file.type.startsWith('image/')) {
      flashMessage('⚠ Only image files');
      return;
    }
    try {
      const base64 = await fileToBase64(file);
      showPreview(slotId, base64);
    } catch (e) {
      console.warn('[visual-dev] compression failed:', e);
      flashMessage('⚠ Failed to process image');
    }
  }

  function handlePasteUrl(slotId, url) {
    if (!url) return;
    if (!url.startsWith('http') && !url.startsWith('data:') && !url.startsWith('/')) {
      url = '/' + url;
    }
    showPreview(slotId, url);
  }

  // ---- EVENT LISTENERS ----
  toggle.addEventListener('click', togglePanel);
  closeBtn.addEventListener('click', closePanel);
  ghostBtn.addEventListener('click', toggleGhost);
  inspectBtn.addEventListener('click', toggleInspect);
  clearBtn.addEventListener('click', () => {
    if (confirm('Clear all swaps? This resets all images to their originals.')) {
      localStorage.removeItem(STORAGE_KEY);
      scanSlots().forEach(s => resetSlot(s.id));
      renderSlots();
      flashMessage('All swaps cleared');
    }
  });
  exportJsonBtn.addEventListener('click', exportJSON);
  exportCodeBtn.addEventListener('click', exportCode);
  exportDiffBtn.addEventListener('click', exportDiff);
  previewClose.addEventListener('click', hidePreview);
  previewCancel.addEventListener('click', hidePreview);
  previewApply.addEventListener('click', () => {
    if (state.previewingSlot) {
      const src = previewAfter.src;
      if (applySwap(state.previewingSlot, src)) {
        hidePreview();
        renderSlots();
        flashMessage('Swap applied!');
      }
    }
  });
  previewPrev.addEventListener('click', () => {
    if (state.library.length > 0 && state.previewingSlot) {
      state.previewIndex = (state.previewIndex - 1 + state.library.length) % state.library.length;
      previewAfter.src = state.library[state.previewIndex];
    }
  });
  previewNext.addEventListener('click', () => {
    if (state.library.length > 0 && state.previewingSlot) {
      state.previewIndex = (state.previewIndex + 1) % state.library.length;
      previewAfter.src = state.library[state.previewIndex];
    }
  });
  libraryClose.addEventListener('click', closeLibrary);

  searchInput.addEventListener('input', (e) => {
    state.searchQuery = e.target.value;
    renderSlots();
  });

  viewSelect.addEventListener('change', (e) => {
    state.viewMode = e.target.value;
    renderSlots();
  });

  if (pageSelect) {
    pageSelect.addEventListener('change', (e) => {
      state.pageFilter = e.target.value;
      renderSlots();
    });
  }

  libraryGrid.addEventListener('click', (e) => {
    const item = e.target.closest('.vd-lib-item');
    if (item) {
      const img = item.dataset.img;
      if (state.selectedSlot) showPreview(state.selectedSlot, img);
      closeLibrary();
    }
  });

  slotsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.vd-swap-btn');
    if (!btn) return;
    e.stopPropagation();

    const action = btn.dataset.action;
    const slotId = btn.dataset.slot;

    switch (action) {
      case 'browse':
        openLibrary(slotId);
        break;
      case 'paste': {
        const url = prompt('Paste image URL:');
        if (url) handlePasteUrl(slotId, url);
        break;
      }
      case 'reset':
        resetSlot(slotId);
        renderSlots();
        flashMessage('Slot reset');
        break;
      case 'copy': {
        const el = document.querySelector(`[data-swap="${slotId}"]`);
        if (el) {
          const path = getCurrentPath(el, detectSlotType(el));
          navigator.clipboard.writeText(path).then(() => flashMessage('Path copied!'));
        }
        break;
      }
    }
  });

  // Slot drag-and-drop
  slotsEl.addEventListener('dragover', (e) => {
    const slot = e.target.closest('.vd-slot');
    if (slot) {
      e.preventDefault();
      slot.classList.add('vd-slot-dragover');
    }
  });

  slotsEl.addEventListener('dragleave', (e) => {
    const slot = e.target.closest('.vd-slot');
    if (slot) slot.classList.remove('vd-slot-dragover');
  });

  slotsEl.addEventListener('drop', async (e) => {
    const slot = e.target.closest('.vd-slot');
    if (slot) {
      e.preventDefault();
      slot.classList.remove('vd-slot-dragover');
      const slotId = slot.dataset.slot;
      const file = e.dataTransfer.files[0];
      if (file) await handleDrop(slotId, file);
    }
  });

  // Global drag-and-drop
  let dragCounter = 0;
  document.addEventListener('dragenter', (e) => {
    if (state.isOpen) return;
    dragCounter++;
    e.preventDefault();
    document.body.classList.add('vd-drag-active');
  });

  document.addEventListener('dragleave', (e) => {
    if (state.isOpen) return;
    dragCounter--;
    if (dragCounter <= 0) {
      dragCounter = 0;
      document.body.classList.remove('vd-drag-active');
    }
  });

  document.addEventListener('dragover', (e) => {
    if (!state.isOpen) e.preventDefault();
  });

  document.addEventListener('drop', async (e) => {
    dragCounter = 0;
    document.body.classList.remove('vd-drag-active');
    if (state.isOpen) return;

    const file = e.dataTransfer.files[0];
    if (!file || !file.type.startsWith('image/')) return;

    e.preventDefault();
    const el = e.target.closest('[data-swap]') || e.target;
    if (el.dataset?.swap) {
      await handleDrop(el.dataset.swap, file);
      openPanel();
      renderSlots();
    } else {
      flashMessage('⚠ Drop on an image with data-swap');
    }
  });

  // Inspect mode
  document.addEventListener('click', (e) => {
    if (!state.isInspect) return;
    const target = e.target;

    // Don't inspect the tool itself
    if (target.closest('#visual-dev-wrapper')) return;

    if (target.tagName === 'IMG' || target.style?.backgroundImage) {
      let slotId = target.dataset.swap;
      if (!slotId) {
        state.autoImgCounter++;
        slotId = `auto-img-${state.autoImgCounter}`;
        target.setAttribute('data-swap', slotId);
      }
      state.isInspect = false;
      inspectBtn.classList.remove('vd-active');
      document.body.classList.remove('vd-inspect-mode');
      openPanel();
      setTimeout(() => {
        const slotHeader = slotsEl.querySelector(`[data-slot="${slotId}"]`);
        if (slotHeader) slotHeader.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 150);
    }
  });

  // Stop propagation inside panel during inspect
  panel.addEventListener('click', (e) => {
    if (state.isInspect) e.stopPropagation();
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
      if (e.key === 'Escape') {
        e.target.blur();
        return;
      }
      return;
    }

    const key = e.key.toLowerCase();

    switch (key) {
      case 'v':
        e.preventDefault();
        togglePanel();
        break;
      case 'escape':
        if (previewOverlay.classList.contains('vd-open')) hidePreview();
        else if (libraryOverlay.classList.contains('vd-open')) closeLibrary();
        else if (state.isInspect) toggleInspect();
        else if (state.isOpen) closePanel();
        break;
      case 'g':
        e.preventDefault();
        toggleGhost();
        break;
      case 'i':
        e.preventDefault();
        toggleInspect();
        break;
      case 'r':
        if (state.previewingSlot) {
          resetSlot(state.previewingSlot);
          hidePreview();
          renderSlots();
          flashMessage('Slot reset');
        }
        break;
    }

    if (e.ctrlKey || e.metaKey) {
      switch (key) {
        case 'e':
          e.preventDefault();
          exportJSON();
          break;
        case 'c':
          e.preventDefault();
          exportCode();
          break;
      }
    }

    if (state.previewingSlot && state.library.length > 0) {
      switch (e.key) {
        case 'arrowleft':
          e.preventDefault();
          state.previewIndex = (state.previewIndex - 1 + state.library.length) % state.library.length;
          previewAfter.src = state.library[state.previewIndex];
          break;
        case 'arrowright':
          e.preventDefault();
          state.previewIndex = (state.previewIndex + 1) % state.library.length;
          previewAfter.src = state.library[state.previewIndex];
          break;
      }
    }
  });

  // ---- AUTO-POPULATE LIBRARY ----
  function buildPageLibrary() {
    if (state.library.length > 0) return;
    const els = document.querySelectorAll('[data-swap]');
    const paths = new Set();
    els.forEach((el) => {
      const type = detectSlotType(el);
      const path = getCurrentPath(el, type);
      if (path && !path.startsWith('data:')) paths.add(path);
      const original = el.getAttribute('data-swap-original');
      if (original && !original.startsWith('data:')) paths.add(original);
    });
    state.library = Array.from(paths);
  }

  // ---- INIT ----
  function restoreSwaps() {
    const swaps = loadSwaps();
    const slots = scanSlots();
    const slotIds = new Set(slots.map(s => s.id));
    Object.entries(swaps).forEach(([id, path]) => {
      if (slotIds.has(id)) applySwap(id, path);
    });
  }

  restoreSwaps();
  buildPageLibrary();
  renderSlots();
})();
</script>

