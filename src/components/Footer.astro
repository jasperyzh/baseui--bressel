---
/**
 * Footer - 4-column layout
 * Brand voice: "World-class padel. Built around people."
 * Col 1: Brand + social
 * Col 2: Quick Links
 * Col 3: Connect (WhatsApp + Email)
 * Col 4: Stay in the Game (Newsletter signup)
 * Bottom: Copyright
 */
import Icon from './Icon.astro';
import { whatsappUrl, BRAND_EMAIL } from '../lib/config';
import Input from './starwind/input/Input.astro';
---

<footer class="bg-bressel-black border-t border-bressel-zinc-800/60 py-16 md:py-24">
  <div class="container-custom">

    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-12">

      <!-- Col 1: Brand -->
      <div>
        <a href="/" class="inline-block mb-4">
          <img src="/assets/logo-bressel-white.png" alt="BRESSEL™" class="h-6 md:h-8 w-auto" />
        </a>
        <p class="body mb-6">
          World-class padel. Built around people.
        </p>
        <div class="flex gap-4">
          <a href="#" aria-label="Instagram" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
            <Icon name="instagram" size={18} />
          </a>
          <a href="#" aria-label="YouTube" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
            <Icon name="youtube" size={18} />
          </a>
          <a href={whatsappUrl("Hi BRESSEL! I'd like to get in touch.")} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
            <Icon name="whatsapp" size={18} />
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h4 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide text-bressel-white mb-4">QUICK LINKS</h4>
        <ul class="flex flex-col gap-2">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/academy" class="nav-link">Academy</a></li>
          <li><a href="/community" class="nav-link">Community</a></li>
          <li><a href="/about" class="nav-link">About</a></li>
        </ul>
      </div>

      <!-- Col 3: Connect -->
      <div>
        <h4 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide text-bressel-white mb-4">CONNECT</h4>
        <ul class="flex flex-col gap-2">
          <li>
            <a href={whatsappUrl("Hi BRESSEL! I'd like to get in touch.")} target="_blank" rel="noopener noreferrer" class="nav-link flex items-center gap-2">
              <Icon name="whatsapp" size={14} class="text-bressel-red" />
              WhatsApp
            </a>
          </li>
          <li><a href={`mailto:${BRAND_EMAIL}`} class="nav-link">{BRAND_EMAIL}</a></li>
          <li><a href="/contact" class="nav-link">Contact Page</a></li>
        </ul>
      </div>

      <!-- Col 4: Stay in the Game -->
      <div>
        <h4 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide text-bressel-white mb-4">STAY IN THE GAME</h4>
        <p class="body text-sm mb-4">Gear drops, tournament invites, stories from the court.</p>

        <!-- Email signup -->
        <form class="flex mb-4" onsubmit="event.preventDefault(); alert('Subscribed!');">
          <Input
            type="email"
            name="email"
            required
            placeholder="EMAIL"
            class="flex-1 border-r-0"
            style="text-transform: uppercase; font-weight: 700; font-size: 0.6875rem; letter-spacing: 0.1em;"
          />
          <button type="submit" class="flex-shrink-0 px-4 py-2 bg-bressel-red text-bressel-white text-[0.625rem] font-bold uppercase tracking-wider cursor-pointer hover:bg-bressel-red-hover transition-colors border-0">
            SUBSCRIBE
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-bressel-zinc-800/60 pt-6 flex flex-col md:flex-row items-center justify-between gap-2">
      <p class="text-[0.625rem] font-bold uppercase tracking-widest text-bressel-zinc-600">
        © 2026 BRESSEL™. All rights reserved.
      </p>
    </div>

  </div>
</footer>
