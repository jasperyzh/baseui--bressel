---
/**
 * Footer — 4-column layout
 * Brand voice: "World-class padel. Built around people."
 * Col 1: Brand + social
 * Col 2: Quick Links
 * Col 3: Connect (WhatsApp + Email)
 * Col 4: Stay in the Game (Newsletter signup)
 * Bottom: Copyright
 */
import Input from './starwind/input/Input.astro';
---

<footer class="bg-bressel-black border-t border-bressel-zinc-800/60 py-16 md:py-24">
  <div class="container-custom">

    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-12">

      <!-- Col 1: Brand -->
      <div>
        <a href="/" class="inline-block mb-4">
          <img src="/assets/logo-bressel-white.png" alt="BRESSEL™" class="h-6 md:h-8 w-auto" />
        </a>
        <p class="body mb-6">
          World-class padel. Built around people.
        </p>
        <div class="flex gap-4">
          <a href="#" aria-label="Instagram" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.979 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" aria-label="YouTube" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://wa.me/60123456789" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h4 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide text-bressel-white mb-4">QUICK LINKS</h4>
        <ul class="flex flex-col gap-2">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/academy" class="nav-link">Academy</a></li>
          <li><a href="/community" class="nav-link">Community</a></li>
          <li><a href="/about" class="nav-link">About</a></li>
        </ul>
      </div>

      <!-- Col 3: Connect -->
      <div>
        <h4 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide text-bressel-white mb-4">CONNECT</h4>
        <ul class="flex flex-col gap-2">
          <li>
            <a href="https://wa.me/60123456789" target="_blank" rel="noopener noreferrer" class="nav-link flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-bressel-red"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </li>
          <li><a href="mailto:hola@bresselsports.com" class="nav-link">hola@bresselsports.com</a></li>
          <li><a href="/contact" class="nav-link">Contact Page</a></li>
        </ul>
      </div>

      <!-- Col 4: Stay in the Game -->
      <div>
        <h4 class="font-header font-bold text-[0.6875rem] uppercase tracking-wide text-bressel-white mb-4">STAY IN THE GAME</h4>
        <p class="body text-sm mb-4">Gear drops, tournament invites, stories from the court.</p>

        <!-- Email signup -->
        <form class="flex mb-4" onsubmit="event.preventDefault(); alert('Subscribed!');">
          <Input
            type="email"
            name="email"
            required
            placeholder="EMAIL"
            class="flex-1 border-r-0"
            style="text-transform: uppercase; font-weight: 700; font-size: 0.6875rem; letter-spacing: 0.1em;"
          />
          <button type="submit" class="flex-shrink-0 px-4 py-2 bg-bressel-red text-bressel-white text-[0.625rem] font-bold uppercase tracking-wider cursor-pointer hover:bg-bressel-red-hover transition-colors border-0">
            SUBSCRIBE
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-bressel-zinc-800/60 pt-6 flex flex-col md:flex-row items-center justify-between gap-2">
      <p class="text-[0.625rem] font-bold uppercase tracking-widest text-bressel-zinc-600">
        © 2026 BRESSEL™. All rights reserved.
      </p>
    </div>

  </div>
</footer>
