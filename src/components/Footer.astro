---
/**
 * Footer - court-surface closeout
 * Brand voice: "World-class padel. Built around people."
 */
import { Icon } from 'astro-icon/components';
import { whatsappUrl, BRAND_EMAIL, SOCIAL } from '../lib/config';
---

<footer class="site-footer noise">
  <div class="container-custom site-footer__inner">

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo-link">
          <img src="/assets/logo-bressel-lockup.png" alt="BRESSEL™" class="site-footer__logo" />
        </a>
        <p class="site-footer__headline">
          Tough court energy. World-class padel. Built around people.
        </p>
        <p class="site-footer__copy">
          Coaching, games, community nights, and the kind of sessions that leave dust on your shoes.
        </p>
        <div class="site-footer__socials">
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="site-footer__icon-link">
            <Icon name="instagram" size={18} />
          </a>
          <!-- <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="site-footer__icon-link">
            <Icon name="youtube" size={18} />
          </a> -->
          <a href={whatsappUrl("Hi BRESSEL! I'd like to get in touch.")} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="site-footer__icon-link">
            <Icon name="whatsapp" size={18} />
          </a>
        </div>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <h4 class="site-footer__label">Get on Court</h4>
        <ul class="site-footer__links">
          <li><a href="/academy">Academy</a></li>
          <li><a href="/community">Community Play</a></li>
          <li><a href="/shop">BRESSEL PRO</a></li>
          <li><a href="/about">The BRESSEL Story</a></li>
        </ul>
      </nav>

      <div class="site-footer__contact">
        <h4 class="site-footer__label">Start Something</h4>
        <ul class="site-footer__links">
          <li>
            <a href={whatsappUrl("Hi BRESSEL! I'd like to get in touch.")} target="_blank" rel="noopener noreferrer">
              WhatsApp the team
            </a>
          </li>
          <li><a href={`mailto:${BRAND_EMAIL}`}>{BRAND_EMAIL}</a></li>
          <li><a href="/contact">Book a conversation</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © 2026 BRESSEL™. All rights reserved.
      </p>
      <a href="/contact">Court time starts here</a>
    </div>

  </div>
</footer>

