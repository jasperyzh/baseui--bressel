const icon = iconMap[name];
const svgHeight = name === "chevron-down" ? size * 1.5 : name === "mail" ? size * 0.625 : size;
---

<svg
  width={size}
  height={svgHeight}
  viewBox={icon.viewBox}
  fill={icon.fill}
  stroke={icon.stroke}
  stroke-width={icon.strokeWidth}
  stroke-linecap={icon.strokeLinecap}
  stroke-linejoin={icon.strokeLinejoin}
  class={className}
>
  <Fragment set:html={icon.content} />
</svg>
