/**
 * Icon - Single-source icon component for BRESSEL™
 * Replaces copy-pasted SVGs across Header, Footer, Hero, Shop, Pricing, etc.
 *
 * Usage:
 *   <Icon name="whatsapp" size={18} class="text-bressel-red" />
 *   <Icon name="arrow-right" size={14} />
 */

