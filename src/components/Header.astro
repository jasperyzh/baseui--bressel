---
/**
 * Header — Sticky nav with BRESSEL logo, 5-page navigation
 * Nav: HOME | ACADEMY | COMMUNITY | ABOUT | CONTACT
 * Mobile: Full-screen overlay menu
 * No standalone "BOOK SESSION" nav item — CTAs are WhatsApp-based on each page
 */
import Icon from './Icon.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-bressel-black/90 backdrop-blur-md border-b border-bressel-zinc-800/60 px-6 md:px-8 transition-all duration-300" id="site-header">
  <div class="max-w-[80rem] mx-auto flex items-center justify-between h-16 md:h-20 transition-all duration-300" id="header-inner">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0" aria-label="BRESSEL Home">
      <img
        src="/assets/logo-bressel-white.png"
        alt="BRESSEL™"
        class="h-6 md:h-8 w-auto"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-10">
      <a href="/" class="nav-link">HOME</a>
      <a href="/academy" class="nav-link">ACADEMY</a>
      <a href="/community" class="nav-link">COMMUNITY</a>
      <a href="/about" class="nav-link">ABOUT</a>
      <a href="/contact" class="nav-link">CONTACT</a>
    </nav>

    <!-- Right: Mobile hamburger only (no BOOK SESSION button in nav) -->
    <div class="flex items-center gap-4">
      <button
        id="menu-toggle"
        class="md:hidden text-bressel-white text-2xl p-1"
        aria-label="Open menu"
        onclick="document.getElementById('mobile-menu').classList.remove('translate-x-full')"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>

  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[200] bg-bressel-black/95 backdrop-blur-md flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-300"
>
  <!-- Close button -->
  <button
    class="absolute top-6 right-6 text-bressel-white text-3xl"
    aria-label="Close menu"
    onclick="document.getElementById('mobile-menu').classList.add('translate-x-full')"
  >
    <Icon name="x" size={28} />
  </button>

  <!-- Mobile Nav Links -->
  <nav class="flex flex-col items-center gap-6">
    <a href="/" class="nav-link text-2xl tracking-wider">HOME</a>
    <a href="/academy" class="nav-link text-2xl tracking-wider">ACADEMY</a>
    <a href="/community" class="nav-link text-2xl tracking-wider">COMMUNITY</a>
    <a href="/about" class="nav-link text-2xl tracking-wider">ABOUT</a>
    <a href="/contact" class="nav-link text-2xl tracking-wider">CONTACT</a>
  </nav>

  <!-- Social Icons -->
  <div class="flex gap-6 mt-8">
    <a href="#" aria-label="Instagram" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
      <Icon name="instagram" size={22} />
    </a>
    <a href="#" aria-label="YouTube" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
      <Icon name="youtube" size={22} />
    </a>
    <a href="#" aria-label="WhatsApp" class="text-bressel-zinc-600 hover:text-bressel-red transition-colors">
      <Icon name="whatsapp" size={22} />
    </a>
  </div>
</div>

<!-- Close menu on link click (mobile) -->
<script>
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('mobile-menu').classList.add('translate-x-full');
    });
  });
</script>

<!-- Header shrink on scroll -->
<script is:inline>
  const header = document.getElementById('site-header');
  const inner = document.getElementById('header-inner');
  const logo = header.querySelector('img');
  if (header && inner) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 100) {
        header.style.setProperty('background-color', 'rgba(9,8,8,0.98)');
        inner.classList.add('h-12', 'md:h-14');
        inner.classList.remove('h-16', 'md:h-20');
        if (logo) { logo.style.height = '1.25rem'; }
      } else {
        header.style.setProperty('background-color', 'rgba(9,8,8,0.9)');
        inner.classList.add('h-16', 'md:h-20');
        inner.classList.remove('h-12', 'md:h-14');
        if (logo) { logo.style.height = ''; }
      }
    }, { passive: true });
  }
</script>
