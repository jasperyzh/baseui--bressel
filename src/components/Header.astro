---
/**
 * Header - Sticky nav with BRESSEL logo, 5-page navigation
 * Active state: red underline on current page
 * Mobile: Full-screen overlay menu
 */
import { Icon } from 'astro-icon/components';
import { whatsappUrl, SOCIAL } from '../lib/config';
import WhatsAppButton from './WhatsAppButton.astro';

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/academy', label: 'ACADEMY' },
  { href: '/community', label: 'COMMUNITY' },
  { href: '/shop', label: 'SHOP' },
  { href: '/about', label: 'ABOUT' },
  { href: '/contact', label: 'CONTACT' },
];

const ctaMessage = "Hi BRESSEL! I'd like to book a session. Could you share the next available slots?";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-bressel-black/90 backdrop-blur-md border-b border-[#27272a] px-6 md:px-8 transition-all duration-300" id="site-header">
  <div class="max-w-[80rem] mx-auto flex items-center justify-between h-20 md:h-24 transition-all duration-300" id="header-inner">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0" aria-label="BRESSEL Home">
      <img
        src="/assets/logo-bressel-white.png"
        alt="BRESSEL™"
        class="h-9 md:h-11 w-auto transition-all duration-300"
        id="site-logo"
      />
    </a>

    <!-- Desktop Navigation (centered) -->
    <nav class="hidden md:flex items-center gap-0 absolute left-1/2 -translate-x-1/2">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`nav-link relative px-4 py-6 transition-colors duration-200 ${isActive ? 'text-bressel-white' : ''}`}
          >
            {link.label}
            {isActive && (
              <span class="absolute bottom-3 left-4 right-4 h-0.5 bg-bressel-red"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right: Book Session CTA (desktop) + Mobile hamburger -->
    <div class="flex items-center gap-3">
      <WhatsAppButton
        class="hidden md:inline-flex hover:scale-[1.03] transition-transform"
        variant="primary"
        size="sm"
        message={ctaMessage}
      >
        BOOK SESSION
      </WhatsAppButton>
      <button
        id="menu-toggle"
        class="md:hidden text-bressel-white text-2xl p-1"
        aria-label="Open menu"
        onclick="document.getElementById('mobile-menu').classList.remove('translate-x-full')"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>

  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[200] bg-bressel-black/95 backdrop-blur-md flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-300"
>
  <!-- Close button -->
  <button
    class="absolute top-6 right-6 text-bressel-white text-3xl"
    aria-label="Close menu"
    onclick="document.getElementById('mobile-menu').classList.add('translate-x-full')"
  >
    <Icon name="x" size={28} />
  </button>

  <!-- Mobile Nav Links -->
  <nav class="flex flex-col items-center gap-6">
    <a href="/" class="nav-link text-2xl tracking-wider">HOME</a>
    <a href="/shop" class="nav-link text-2xl tracking-wider">SHOP</a>
    <a href="/academy" class="nav-link text-2xl tracking-wider">ACADEMY</a>
    <a href="/community" class="nav-link text-2xl tracking-wider">COMMUNITY</a>
    <a href="/about" class="nav-link text-2xl tracking-wider">ABOUT</a>
    <a href="/contact" class="nav-link text-2xl tracking-wider">CONTACT</a>
  </nav>

  <!-- Social Icons -->
  <div class="flex gap-6 mt-8">
    <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-muted-foreground hover:text-bressel-red transition-colors">
      <Icon name="instagram" size={22} />
    </a>
    <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-muted-foreground hover:text-bressel-red transition-colors">
      <Icon name="youtube" size={22} />
    </a>
    <a href={SOCIAL.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-muted-foreground hover:text-bressel-red transition-colors">
      <Icon name="whatsapp" size={22} />
    </a>
  </div>
</div>

<!-- Close menu on link click (mobile) -->
<script>
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileMenu) {
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('translate-x-full');
      });
    });
  }
</script>

<!-- Header shrink on scroll -->
<script is:inline>
  const header = document.getElementById('site-header');
  const inner = document.getElementById('header-inner');
  const logo = document.getElementById('site-logo');
  if (header && inner) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 100) {
        header.style.setProperty('background-color', 'rgba(9,8,8,0.98)');
        inner.classList.add('h-14', 'md:h-16');
        inner.classList.remove('h-20', 'md:h-24');
        if (logo) { logo.classList.add('h-7', 'md:h-8'); logo.classList.remove('h-9', 'md:h-11'); }
      } else {
        header.style.setProperty('background-color', 'rgba(9,8,8,0.9)');
        inner.classList.add('h-20', 'md:h-24');
        inner.classList.remove('h-14', 'md:h-16');
        if (logo) { logo.classList.add('h-9', 'md:h-11'); logo.classList.remove('h-7', 'md:h-8'); }
      }
    }, { passive: true });
  }
</script>
