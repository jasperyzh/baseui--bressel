---
/**
 * Layout.astro - BRESSEL™ Base Layout
 *
 * Props:
 *   title?     - Page title (appended with " - BRESSEL™")
 *   description? - Meta description (fallback to default)
 *
 * Theme:
 *   This is a single-theme site (BRESSEL dark).
 *   data-theme="bressel" is set statically.
 *   No dark/light toggle needed.
 */

import "../styles/global.css";
import printCssUrl from "../styles/print.css?url";
import "aos/dist/aos.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const pageTitle = title ? `${title} - BRESSEL™` : "BRESSEL™";
const pageDescription = description || "World-class padel, within reach.";
---

<!doctype html>
<html lang="en" data-theme="bressel">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <!-- Open Graph / Social Preview -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://baseui--bressel.pages.dev/assets/logo/Bressel_Logo_Suite_RGB-14.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://baseui--bressel.pages.dev/assets/logo/Bressel_Logo_Suite_RGB-14.png" />

    <!-- Self-Hosted Fonts: Neue Regrade, Avenir Next, Barlow Condensed (SemiBold) -->
    <link rel="stylesheet" href={printCssUrl} media="print" />

    <!-- BRESSEL theme sync - persists single theme, no toggle needed -->
    <script is:inline>
      (function() {
        var theme = 'bressel';
        document.documentElement.setAttribute('data-theme', theme);

        // Persist across Astro client-side navigations (when view transitions are enabled)
        document.addEventListener('astro:before-swap', function(event) {
          var current = document.documentElement.getAttribute('data-theme') || theme;
          event.newDocument.documentElement.setAttribute('data-theme', current);
        });
      })();
    </script>
  </head>

  <body>
    <!-- Skip to content - accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-bressel-red focus:text-bressel-white focus:font-bold focus:uppercase focus:text-xs focus:tracking-wider focus:no-underline">
      Skip to content
    </a>

    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- AOS scroll animations (bundled, no CDN) -->
    <script>
      import AOS from "aos";

      const init = () => {
        AOS.init({ duration: 600, easing: "ease-out-cubic", once: true, offset: 80 });
        AOS.refresh();
      };

      document.addEventListener("DOMContentLoaded", init);
      document.addEventListener("astro:page-load", init);
      document.addEventListener("astro:after-swap", init);
    </script>
  </body>
</html>
